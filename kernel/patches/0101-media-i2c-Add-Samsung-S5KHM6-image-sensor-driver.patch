From: royka1 <397414+royka1@users.noreply.github.com>
Date: Sat, 22 Nov 2026 12:00:00 +0100
Subject: [PATCH] media: i2c: Add Samsung S5KHM6 image sensor driver

Based on the s5khp1 driver: register tables (initialisation including
a sensor firmware patch, and modes) loaded from a camregs firmware
file, with burst entries (CAMREGS2). One PLL setup for every mode of
the CN module data, so a single link frequency (1195.83 MHz) and a
single pixel clock (1639.995 MHz); modes 12000x9000@8, 4000x3000@30,
4000x2252@60, 1920x1080@120 and 240, 1280x720@360. Power-up order
of the module data: four supplies, reset release, then MCLK.

---
 drivers/media/i2c/Kconfig  |   11 +
 drivers/media/i2c/Makefile |    1 +
 drivers/media/i2c/s5khm6.c | 1081 ++++
 3 files changed, 1093 insertions(+)
 create mode 100644 drivers/media/i2c/s5khm6.c

--- a/drivers/media/i2c/Kconfig
+++ b/drivers/media/i2c/Kconfig
@@ -814,6 +814,17 @@
 	  To compile this driver as a module, choose M here: the
 	  module will be called s5khp1.
 
+config VIDEO_S5KHM6
+	tristate "Samsung S5KHM6 sensor support"
+	select V4L2_CCI_I2C
+	help
+	  This is a V4L2 sensor driver for the Samsung S5KHM6 (ISOCELL HM6)
+	  108MP raw camera sensor with a MIPI C-PHY output. The sensor
+	  register tables are loaded as firmware.
+
+	  To compile this driver as a module, choose M here: the
+	  module will be called s5khm6.
+
 config VIDEO_S5KJN1
 	tristate "Samsung S5KJN1 sensor support"
 	select V4L2_CCI_I2C
--- a/drivers/media/i2c/Makefile
+++ b/drivers/media/i2c/Makefile
@@ -132,6 +132,7 @@
 obj-$(CONFIG_VIDEO_S5K6A3) += s5k6a3.o
 obj-$(CONFIG_VIDEO_S5K4H7) += s5k4h7.o
 obj-$(CONFIG_VIDEO_S5KHP1) += s5khp1.o
+obj-$(CONFIG_VIDEO_S5KHM6) += s5khm6.o
 obj-$(CONFIG_VIDEO_S5KJN1) += s5kjn1.o
 obj-$(CONFIG_VIDEO_SAA6588) += saa6588.o
 obj-$(CONFIG_VIDEO_SAA6752HS) += saa6752hs.o
--- /dev/null
+++ b/drivers/media/i2c/s5khm6.c
@@ -0,0 +1,1081 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * Samsung S5KHM6 (ISOCELL HM6) 108 MP image sensor driver
+ *
+ * Based on the s5khp1/s5k4h7/s5kjn1 drivers (s5kjn1: Copyright (c) 2025
+ * Linaro Ltd). The sensor initialisation (including a sensor firmware
+ * patch) and the mode register tables are module specific and are loaded
+ * from a "camregs" firmware file built from the camera module's own data:
+ *
+ *   char magic[8] = "CAMREGS1" or "CAMREGS2"; u32 n_tables;
+ *   n_tables x { char name[16]; u32 n_entries;
+ *                n_entries x { u16 addr; u16 value; u8 width; u8 pad;
+ *                              u16 delay_us } }
+ *
+ * width 1/2 is a register write; width 0 (CAMREGS2) a burst of `value`
+ * bytes to consecutive addresses, following the entry, padded to 4 bytes.
+ * Tables used: "init", then one of the "modeN" tables.
+ *
+ * The sensor output is MIPI C-PHY with three trios. The module data of
+ * the CN diting unit (sunny_s5khm6_wide) uses one PLL setup for every
+ * mode (the frame rate changes only through the HTS/VTS registers), so
+ * there is a single link frequency and a single pixel clock (1639.995
+ * MHz, the same value the sensor's reference settings carry on other
+ * modules with a 24 MHz MCLK; 0x0306/0x0304 differ exactly by 24/19.2).
+ * Frame rates: 12000x9000 @ 8, 4000x3000 @ 30, 4000x2252 @ 60,
+ * 1920x1080 @ 120 and 240, 1280x720 @ 360.
+ *
+ * The wide lens of the CN module has a DW9800V actuator (0x0c); no
+ * driver for it yet, so focusing is not supported.
+ */
+
+#include <linux/clk.h>
+#include <linux/delay.h>
+#include <linux/firmware.h>
+#include <linux/gpio/consumer.h>
+#include <linux/i2c.h>
+#include <linux/module.h>
+#include <linux/pm_runtime.h>
+#include <linux/regmap.h>
+#include <linux/regulator/consumer.h>
+#include <linux/unaligned.h>
+#include <linux/units.h>
+#include <media/v4l2-cci.h>
+#include <media/v4l2-ctrls.h>
+#include <media/v4l2-device.h>
+#include <media/v4l2-fwnode.h>
+
+#define S5KHM6_MCLK_FREQ		19200000
+#define S5KHM6_DATA_LANES		3
+
+#define S5KHM6_NATIVE_WIDTH		12000
+#define S5KHM6_NATIVE_HEIGHT		9000
+
+/* Register map is similar to MIPI CCS compliant camera sensors */
+#define S5KHM6_REG_CHIP_ID		CCI_REG16(0x0000)
+#define S5KHM6_CHIP_ID			0x1ad6
+
+#define S5KHM6_REG_PAGE			CCI_REG16(0xfcfc)
+#define S5KHM6_PAGE_4000		0x4000
+
+#define S5KHM6_REG_CTRL_MODE		CCI_REG8(0x0100)
+#define S5KHM6_MODE_STREAMING		BIT(0)
+
+#define S5KHM6_REG_ORIENTATION		CCI_REG8(0x0101)
+#define S5KHM6_VFLIP			BIT(1)
+#define S5KHM6_HFLIP			BIT(0)
+/* The module data streams with the readout mirrored and flipped */
+#define S5KHM6_ORIENTATION_DEFAULT	(S5KHM6_VFLIP | S5KHM6_HFLIP)
+
+#define S5KHM6_REG_FRAME_COUNT		CCI_REG8(0x0005)
+
+#define S5KHM6_REG_EXPOSURE		CCI_REG16(0x0202)
+#define S5KHM6_EXPOSURE_MIN		8
+#define S5KHM6_EXPOSURE_STEP		1
+#define S5KHM6_EXPOSURE_MARGIN		22
+
+/* Analogue gain code: 32 = 1x ... 512 = 16x */
+#define S5KHM6_REG_AGAIN		CCI_REG16(0x0204)
+#define S5KHM6_AGAIN_MIN		32
+#define S5KHM6_AGAIN_MAX		512
+#define S5KHM6_AGAIN_STEP		1
+#define S5KHM6_AGAIN_DEFAULT		64
+
+#define S5KHM6_REG_VTS			CCI_REG16(0x0340)
+#define S5KHM6_VTS_MAX			0xffff
+
+#define S5KHM6_REG_TEST_PATTERN		CCI_REG16(0x0600)
+
+#define S5KHM6_FW_DEFAULT		"s5khm6.camregs"
+
+#define to_s5khm6(_sd)			container_of(_sd, struct s5khm6, sd)
+
+/*
+ * C-PHY link frequency (V4L2: pixel rate = link_freq * 2 * trios * 16 /
+ * 7 / bpp) of the sensor's 1639.995 MHz array clock, the same relation
+ * between output pixel clock and link frequency as the S5KHP1 module
+ * data carries. One PLL setup for every mode, so one frequency.
+ */
+static const s64 s5khm6_link_freq_menu[] = {
+	1195830000,
+};
+
+/* Native GRBG; indexed by (vflip << 1 | hflip) relative to the sensor */
+static const u32 s5khm6_mbus_formats[] = {
+	MEDIA_BUS_FMT_SGRBG10_1X10,	MEDIA_BUS_FMT_SRGGB10_1X10,
+	MEDIA_BUS_FMT_SBGGR10_1X10,	MEDIA_BUS_FMT_SGBRG10_1X10,
+};
+
+struct s5khm6_reg {
+	u16 addr;
+	u16 value;		/* register value, or burst length */
+	u8 width;		/* 1, 2, or 0 for a burst */
+	u16 delay_us;
+	const u8 *data;		/* burst bytes */
+};
+
+struct s5khm6_table {
+	const struct s5khm6_reg *regs;
+	unsigned int num_regs;
+};
+
+struct s5khm6_mode {
+	u32 width;			/* Frame width in pixels */
+	u32 height;			/* Frame height in pixels */
+	u32 hts;			/* Horizontal timing size */
+	u32 vts;			/* Default vertical timing size */
+	u32 exposure;			/* Default exposure value */
+	u32 pixel_rate;			/* Pixel array rate: hts * vts * fps */
+	unsigned int link_freq_index;
+	struct v4l2_rect crop;		/* Analogue crop in native pixels */
+	const char *table;		/* Register table in the firmware */
+};
+
+static const char * const s5khm6_test_pattern_menu[] = {
+	"Disabled",
+	"Solid color",
+	"Color bars",
+	"Fade to grey color bars",
+	"PN9",
+};
+
+static const char * const s5khm6_supply_names[] = {
+	"vdda2",	/* WL2866D AVDD2 */
+	"vddio",	/* 1.8 V I/O */
+	"vdda",		/* analogue */
+	"vddd",		/* digital core */
+};
+
+struct s5khm6 {
+	struct device *dev;
+	struct regmap *regmap;
+	struct clk *mclk;
+	struct gpio_desc *reset_gpio;
+	struct regulator_bulk_data supplies[ARRAY_SIZE(s5khm6_supply_names)];
+
+	struct v4l2_subdev sd;
+	struct media_pad pad;
+
+	struct v4l2_ctrl_handler ctrl_handler;
+	struct v4l2_ctrl *link_freq;
+	struct v4l2_ctrl *pixel_rate;
+	struct v4l2_ctrl *hblank;
+	struct v4l2_ctrl *vblank;
+	struct v4l2_ctrl *exposure;
+	struct v4l2_ctrl *vflip;
+	struct v4l2_ctrl *hflip;
+
+	unsigned long link_freq_bitmap;
+
+	struct s5khm6_table init_table;
+	struct s5khm6_table mode_tables[6];
+
+	const struct s5khm6_mode *mode;
+};
+
+/* Mode table names are the module data's resolution indices */
+static const struct s5khm6_mode s5khm6_supported_modes[] = {
+	{
+		/* full resolution, 8 fps */
+		.width = 12000,
+		.height = 9000,
+		.hts = 20472,
+		.vts = 9984,
+		.exposure = 9400,
+		.pixel_rate = 1639995000,
+		.link_freq_index = 0,
+		.crop = { 0, 0, 12000, 9000 },
+		.table = "mode0",
+	},
+	{
+		/* 3x3 binned (Nonacell), 30 fps */
+		.width = 4000,
+		.height = 3000,
+		.hts = 8704,
+		.vts = 6240,
+		.exposure = 5800,
+		.pixel_rate = 1639995000,
+		.link_freq_index = 0,
+		.crop = { 0, 0, 12000, 9000 },
+		.table = "mode1",
+	},
+	{
+		/* 3x3 binned 3:2, 60 fps */
+		.width = 4000,
+		.height = 2252,
+		.hts = 8704,
+		.vts = 3128,
+		.exposure = 2900,
+		.pixel_rate = 1639995000,
+		.link_freq_index = 0,
+		.crop = { 0, 1125, 12000, 6750 },
+		.table = "mode3",
+	},
+	{
+		/* binned 16:9, 120 fps */
+		.width = 1920,
+		.height = 1080,
+		.hts = 8704,
+		.vts = 1564,
+		.exposure = 1400,
+		.pixel_rate = 1639995000,
+		.link_freq_index = 0,
+		.crop = { 0, 1125, 12000, 6750 },
+		.table = "mode4",
+	},
+	{
+		/* binned 16:9, 240 fps */
+		.width = 1920,
+		.height = 1080,
+		.hts = 5728,
+		.vts = 1192,
+		.exposure = 1100,
+		.pixel_rate = 1639995000,
+		.link_freq_index = 0,
+		.crop = { 0, 1125, 12000, 6750 },
+		.table = "mode5",
+	},
+	{
+		/* binned 16:9, 360 fps */
+		.width = 1280,
+		.height = 720,
+		.hts = 5624,
+		.vts = 810,
+		.exposure = 700,
+		.pixel_rate = 1639995000,
+		.link_freq_index = 0,
+		.crop = { 0, 1125, 12000, 6750 },
+		.table = "mode6",
+	},
+};
+
+static int s5khm6_write_table(struct s5khm6 *s5khm6,
+			      const struct s5khm6_table *table)
+{
+	unsigned int i;
+	int ret = 0;
+
+	for (i = 0; i < table->num_regs; i++) {
+		const struct s5khm6_reg *r = &table->regs[i];
+
+		if (r->width == 0) {
+			ret = regmap_bulk_write(s5khm6->regmap, r->addr,
+						r->data, r->value);
+		} else {
+			u32 reg = r->width == 2 ? CCI_REG16(r->addr) :
+						  CCI_REG8(r->addr);
+
+			cci_write(s5khm6->regmap, reg, r->value, &ret);
+		}
+		if (ret) {
+			dev_err(s5khm6->dev, "write to 0x%04x failed: %d\n",
+				r->addr, ret);
+			return ret;
+		}
+		if (r->delay_us)
+			fsleep(r->delay_us);
+	}
+
+	return 0;
+}
+
+static void s5khm6_update_mode_ctrls(struct s5khm6 *s5khm6,
+				     const struct s5khm6_mode *mode)
+{
+	s64 hblank, vblank, exposure_max;
+
+	__v4l2_ctrl_s_ctrl(s5khm6->link_freq, mode->link_freq_index);
+	__v4l2_ctrl_modify_range(s5khm6->pixel_rate, mode->pixel_rate,
+				 mode->pixel_rate, 1, mode->pixel_rate);
+
+	hblank = mode->hts - mode->width;
+	__v4l2_ctrl_modify_range(s5khm6->hblank, hblank, hblank, 1, hblank);
+
+	vblank = mode->vts - mode->height;
+	__v4l2_ctrl_modify_range(s5khm6->vblank, vblank,
+				 S5KHM6_VTS_MAX - mode->height, 1, vblank);
+	__v4l2_ctrl_s_ctrl(s5khm6->vblank, vblank);
+
+	exposure_max = mode->vts - S5KHM6_EXPOSURE_MARGIN;
+	__v4l2_ctrl_modify_range(s5khm6->exposure, S5KHM6_EXPOSURE_MIN,
+				 exposure_max, S5KHM6_EXPOSURE_STEP,
+				 mode->exposure);
+	__v4l2_ctrl_s_ctrl(s5khm6->exposure, mode->exposure);
+}
+
+static int s5khm6_set_ctrl(struct v4l2_ctrl *ctrl)
+{
+	struct s5khm6 *s5khm6 = container_of(ctrl->handler, struct s5khm6,
+					     ctrl_handler);
+	const struct s5khm6_mode *mode = s5khm6->mode;
+	s64 exposure_max;
+	int ret;
+
+	/* Propagate change of current control to all related controls */
+	switch (ctrl->id) {
+	case V4L2_CID_VBLANK:
+		/* Update max exposure while meeting expected vblanking */
+		exposure_max = mode->height + ctrl->val - S5KHM6_EXPOSURE_MARGIN;
+		__v4l2_ctrl_modify_range(s5khm6->exposure,
+					 s5khm6->exposure->minimum,
+					 exposure_max,
+					 s5khm6->exposure->step,
+					 s5khm6->exposure->default_value);
+		break;
+	}
+
+	/* V4L2 controls are applied, when sensor is powered up for streaming */
+	if (!pm_runtime_get_if_active(s5khm6->dev))
+		return 0;
+
+	switch (ctrl->id) {
+	case V4L2_CID_ANALOGUE_GAIN:
+		ret = cci_write(s5khm6->regmap, S5KHM6_REG_AGAIN, ctrl->val, NULL);
+		break;
+	case V4L2_CID_EXPOSURE:
+		ret = cci_write(s5khm6->regmap, S5KHM6_REG_EXPOSURE,
+				ctrl->val, NULL);
+		break;
+	case V4L2_CID_VBLANK:
+		ret = cci_write(s5khm6->regmap, S5KHM6_REG_VTS,
+				ctrl->val + mode->height, NULL);
+		break;
+	case V4L2_CID_VFLIP:
+	case V4L2_CID_HFLIP:
+		ret = cci_write(s5khm6->regmap, S5KHM6_REG_ORIENTATION,
+				S5KHM6_ORIENTATION_DEFAULT ^
+				((s5khm6->vflip->val ? S5KHM6_VFLIP : 0) |
+				 (s5khm6->hflip->val ? S5KHM6_HFLIP : 0)), NULL);
+		break;
+	case V4L2_CID_TEST_PATTERN:
+		ret = cci_write(s5khm6->regmap, S5KHM6_REG_TEST_PATTERN,
+				ctrl->val, NULL);
+		break;
+	default:
+		ret = 0;
+		break;
+	}
+
+	pm_runtime_put(s5khm6->dev);
+
+	return ret;
+}
+
+static const struct v4l2_ctrl_ops s5khm6_ctrl_ops = {
+	.s_ctrl = s5khm6_set_ctrl,
+};
+
+static int s5khm6_init_controls(struct s5khm6 *s5khm6)
+{
+	struct v4l2_ctrl_handler *ctrl_hdlr = &s5khm6->ctrl_handler;
+	const struct s5khm6_mode *mode = s5khm6->mode;
+	s64 hblank, vblank, exposure_max;
+	struct v4l2_fwnode_device_properties props;
+	int ret;
+
+	v4l2_ctrl_handler_init(ctrl_hdlr, 11);
+
+	s5khm6->link_freq = v4l2_ctrl_new_int_menu(ctrl_hdlr, &s5khm6_ctrl_ops,
+					V4L2_CID_LINK_FREQ,
+					ARRAY_SIZE(s5khm6_link_freq_menu) - 1,
+					mode->link_freq_index,
+					s5khm6_link_freq_menu);
+	if (s5khm6->link_freq)
+		s5khm6->link_freq->flags |= V4L2_CTRL_FLAG_READ_ONLY;
+
+	s5khm6->pixel_rate = v4l2_ctrl_new_std(ctrl_hdlr, &s5khm6_ctrl_ops,
+					       V4L2_CID_PIXEL_RATE,
+					       mode->pixel_rate,
+					       mode->pixel_rate, 1,
+					       mode->pixel_rate);
+
+	hblank = mode->hts - mode->width;
+	s5khm6->hblank = v4l2_ctrl_new_std(ctrl_hdlr, &s5khm6_ctrl_ops,
+					   V4L2_CID_HBLANK, hblank,
+					   hblank, 1, hblank);
+	if (s5khm6->hblank)
+		s5khm6->hblank->flags |= V4L2_CTRL_FLAG_READ_ONLY;
+
+	vblank = mode->vts - mode->height;
+	s5khm6->vblank = v4l2_ctrl_new_std(ctrl_hdlr, &s5khm6_ctrl_ops,
+					   V4L2_CID_VBLANK, vblank,
+					   S5KHM6_VTS_MAX - mode->height, 1,
+					   vblank);
+
+	v4l2_ctrl_new_std(ctrl_hdlr, &s5khm6_ctrl_ops, V4L2_CID_ANALOGUE_GAIN,
+			  S5KHM6_AGAIN_MIN, S5KHM6_AGAIN_MAX,
+			  S5KHM6_AGAIN_STEP, S5KHM6_AGAIN_DEFAULT);
+
+	exposure_max = mode->vts - S5KHM6_EXPOSURE_MARGIN;
+	s5khm6->exposure = v4l2_ctrl_new_std(ctrl_hdlr, &s5khm6_ctrl_ops,
+					     V4L2_CID_EXPOSURE,
+					     S5KHM6_EXPOSURE_MIN,
+					     exposure_max,
+					     S5KHM6_EXPOSURE_STEP,
+					     mode->exposure);
+
+	v4l2_ctrl_new_std_menu_items(ctrl_hdlr, &s5khm6_ctrl_ops,
+				     V4L2_CID_TEST_PATTERN,
+				     ARRAY_SIZE(s5khm6_test_pattern_menu) - 1,
+				     0, 0, s5khm6_test_pattern_menu);
+
+	s5khm6->hflip = v4l2_ctrl_new_std(ctrl_hdlr, &s5khm6_ctrl_ops,
+					  V4L2_CID_HFLIP, 0, 1, 1, 0);
+	if (s5khm6->hflip)
+		s5khm6->hflip->flags |= V4L2_CTRL_FLAG_MODIFY_LAYOUT;
+
+	s5khm6->vflip = v4l2_ctrl_new_std(ctrl_hdlr, &s5khm6_ctrl_ops,
+					  V4L2_CID_VFLIP, 0, 1, 1, 0);
+	if (s5khm6->vflip)
+		s5khm6->vflip->flags |= V4L2_CTRL_FLAG_MODIFY_LAYOUT;
+
+	ret = v4l2_fwnode_device_parse(s5khm6->dev, &props);
+	if (ret)
+		goto error_free_hdlr;
+
+	ret = v4l2_ctrl_new_fwnode_properties(ctrl_hdlr, &s5khm6_ctrl_ops,
+					      &props);
+	if (ret)
+		goto error_free_hdlr;
+
+	if (ctrl_hdlr->error) {
+		ret = ctrl_hdlr->error;
+		goto error_free_hdlr;
+	}
+
+	s5khm6->sd.ctrl_handler = ctrl_hdlr;
+
+	return 0;
+
+error_free_hdlr:
+	v4l2_ctrl_handler_free(ctrl_hdlr);
+
+	return ret;
+}
+
+static int s5khm6_enable_streams(struct v4l2_subdev *sd,
+				 struct v4l2_subdev_state *state, u32 pad,
+				 u64 streams_mask)
+{
+	struct s5khm6 *s5khm6 = to_s5khm6(sd);
+	unsigned int idx = s5khm6->mode - s5khm6_supported_modes;
+	int ret;
+
+	ret = pm_runtime_resume_and_get(s5khm6->dev);
+	if (ret)
+		return ret;
+
+	ret = s5khm6_write_table(s5khm6, &s5khm6->init_table);
+	if (!ret)
+		ret = s5khm6_write_table(s5khm6, &s5khm6->mode_tables[idx]);
+	if (ret)
+		goto error;
+
+	cci_write(s5khm6->regmap, S5KHM6_REG_PAGE, S5KHM6_PAGE_4000, &ret);
+	if (ret)
+		goto error;
+
+	/* Also writes the orientation register */
+	ret = __v4l2_ctrl_handler_setup(s5khm6->sd.ctrl_handler);
+
+	cci_write(s5khm6->regmap, S5KHM6_REG_CTRL_MODE,
+		  S5KHM6_MODE_STREAMING, &ret);
+	if (ret)
+		goto error;
+
+	return 0;
+
+error:
+	dev_err(s5khm6->dev, "failed to start streaming: %d\n", ret);
+	pm_runtime_put_autosuspend(s5khm6->dev);
+
+	return ret;
+}
+
+static int s5khm6_disable_streams(struct v4l2_subdev *sd,
+				  struct v4l2_subdev_state *state, u32 pad,
+				  u64 streams_mask)
+{
+	struct s5khm6 *s5khm6 = to_s5khm6(sd);
+	unsigned int i;
+	u64 val;
+	int ret;
+
+	ret = cci_write(s5khm6->regmap, S5KHM6_REG_CTRL_MODE, 0x0, NULL);
+	if (ret)
+		dev_err(s5khm6->dev, "failed to stop streaming: %d\n", ret);
+
+	/* The frame counter reads 0xff once the sensor is in software standby */
+	for (i = 0; !ret && i < 30; i++) {
+		ret = cci_read(s5khm6->regmap, S5KHM6_REG_FRAME_COUNT, &val, NULL);
+		if (ret || val == 0xff)
+			break;
+		usleep_range(USEC_PER_MSEC, 2 * USEC_PER_MSEC);
+	}
+
+	pm_runtime_put_autosuspend(s5khm6->dev);
+
+	return ret;
+}
+
+static u32 s5khm6_get_format_code(struct s5khm6 *s5khm6)
+{
+	unsigned int i;
+
+	/* The Bayer order follows the readout orientation of the sensor */
+	i = S5KHM6_ORIENTATION_DEFAULT ^
+	    ((s5khm6->vflip->val ? S5KHM6_VFLIP : 0) |
+	     (s5khm6->hflip->val ? S5KHM6_HFLIP : 0));
+
+	return s5khm6_mbus_formats[i];
+}
+
+static void s5khm6_update_pad_format(struct s5khm6 *s5khm6,
+				     const struct s5khm6_mode *mode,
+				     struct v4l2_mbus_framefmt *fmt)
+{
+	fmt->code = s5khm6_get_format_code(s5khm6);
+	fmt->width = mode->width;
+	fmt->height = mode->height;
+	fmt->field = V4L2_FIELD_NONE;
+	fmt->colorspace = V4L2_COLORSPACE_RAW;
+	fmt->ycbcr_enc = V4L2_YCBCR_ENC_DEFAULT;
+	fmt->quantization = V4L2_QUANTIZATION_FULL_RANGE;
+	fmt->xfer_func = V4L2_XFER_FUNC_NONE;
+}
+
+static int s5khm6_set_pad_format(struct v4l2_subdev *sd,
+				 struct v4l2_subdev_state *state,
+				 struct v4l2_subdev_format *fmt)
+{
+	struct s5khm6 *s5khm6 = to_s5khm6(sd);
+	const struct s5khm6_mode *mode;
+
+	mode = v4l2_find_nearest_size(s5khm6_supported_modes,
+				      ARRAY_SIZE(s5khm6_supported_modes),
+				      width, height,
+				      fmt->format.width, fmt->format.height);
+
+	s5khm6_update_pad_format(s5khm6, mode, &fmt->format);
+
+	/* Format code could be updated with respect to flip controls */
+	if (fmt->which == V4L2_SUBDEV_FORMAT_TRY || s5khm6->mode == mode)
+		goto set_format;
+
+	if (!(s5khm6->link_freq_bitmap & BIT(mode->link_freq_index)))
+		return -EINVAL;
+
+	/* Update limits and set FPS and exposure to default values */
+	s5khm6_update_mode_ctrls(s5khm6, mode);
+	if (s5khm6->sd.ctrl_handler->error)
+		return s5khm6->sd.ctrl_handler->error;
+
+	s5khm6->mode = mode;
+
+set_format:
+	*v4l2_subdev_state_get_format(state, 0) = fmt->format;
+
+	return 0;
+}
+
+static int s5khm6_enum_mbus_code(struct v4l2_subdev *sd,
+				 struct v4l2_subdev_state *sd_state,
+				 struct v4l2_subdev_mbus_code_enum *code)
+{
+	struct s5khm6 *s5khm6 = to_s5khm6(sd);
+
+	/* Media bus code index is constant, but code formats are not */
+	if (code->index > 0)
+		return -EINVAL;
+
+	code->code = s5khm6_get_format_code(s5khm6);
+
+	return 0;
+}
+
+static int s5khm6_enum_frame_size(struct v4l2_subdev *sd,
+				  struct v4l2_subdev_state *sd_state,
+				  struct v4l2_subdev_frame_size_enum *fse)
+{
+	struct s5khm6 *s5khm6 = to_s5khm6(sd);
+
+	if (fse->index >= ARRAY_SIZE(s5khm6_supported_modes))
+		return -EINVAL;
+
+	if (fse->code != s5khm6_get_format_code(s5khm6))
+		return -EINVAL;
+
+	fse->min_width = s5khm6_supported_modes[fse->index].width;
+	fse->max_width = fse->min_width;
+	fse->min_height = s5khm6_supported_modes[fse->index].height;
+	fse->max_height = fse->min_height;
+
+	return 0;
+}
+
+static int s5khm6_get_selection(struct v4l2_subdev *sd,
+				struct v4l2_subdev_state *sd_state,
+				struct v4l2_subdev_selection *sel)
+{
+	struct s5khm6 *s5khm6 = to_s5khm6(sd);
+
+	switch (sel->target) {
+	case V4L2_SEL_TGT_CROP:
+		sel->r = s5khm6->mode->crop;
+		return 0;
+	case V4L2_SEL_TGT_CROP_DEFAULT:
+	case V4L2_SEL_TGT_CROP_BOUNDS:
+	case V4L2_SEL_TGT_NATIVE_SIZE:
+		sel->r.left = 0;
+		sel->r.top = 0;
+		sel->r.width = S5KHM6_NATIVE_WIDTH;
+		sel->r.height = S5KHM6_NATIVE_HEIGHT;
+		return 0;
+	default:
+		return -EINVAL;
+	}
+}
+
+static int s5khm6_init_state(struct v4l2_subdev *sd,
+			     struct v4l2_subdev_state *state)
+{
+	struct s5khm6 *s5khm6 = to_s5khm6(sd);
+	struct v4l2_subdev_format fmt = {
+		.which = V4L2_SUBDEV_FORMAT_TRY,
+		.pad = 0,
+		.format = {
+			/* Media bus code depends on current flip controls */
+			.width = s5khm6->mode->width,
+			.height = s5khm6->mode->height,
+		},
+	};
+
+	s5khm6_set_pad_format(sd, state, &fmt);
+
+	return 0;
+}
+
+static const struct v4l2_subdev_video_ops s5khm6_video_ops = {
+	.s_stream = v4l2_subdev_s_stream_helper,
+};
+
+static const struct v4l2_subdev_pad_ops s5khm6_pad_ops = {
+	.set_fmt = s5khm6_set_pad_format,
+	.get_fmt = v4l2_subdev_get_fmt,
+	.get_selection = s5khm6_get_selection,
+	.enum_mbus_code = s5khm6_enum_mbus_code,
+	.enum_frame_size = s5khm6_enum_frame_size,
+	.enable_streams = s5khm6_enable_streams,
+	.disable_streams = s5khm6_disable_streams,
+};
+
+static const struct v4l2_subdev_ops s5khm6_subdev_ops = {
+	.video = &s5khm6_video_ops,
+	.pad = &s5khm6_pad_ops,
+};
+
+static const struct v4l2_subdev_internal_ops s5khm6_internal_ops = {
+	.init_state = s5khm6_init_state,
+};
+
+static const struct media_entity_operations s5khm6_subdev_entity_ops = {
+	.link_validate = v4l2_subdev_link_validate,
+};
+
+/* Copy one table of the camregs firmware into driver memory */
+static int s5khm6_parse_table(struct s5khm6 *s5khm6, const u8 *data,
+			      size_t size, size_t *pos, bool bursts,
+			      char *name, struct s5khm6_table *out)
+{
+	struct s5khm6_reg *regs;
+	unsigned int i, n;
+	const u8 *e;
+	u8 *copy;
+
+	if (*pos + 20 > size)
+		return -EINVAL;
+	memcpy(name, data + *pos, 16);
+	name[15] = '\0';
+	n = get_unaligned_le32(data + *pos + 16);
+	*pos += 20;
+	if (n > 8192)
+		return -EINVAL;
+
+	regs = devm_kcalloc(s5khm6->dev, n, sizeof(*regs), GFP_KERNEL);
+	if (!regs)
+		return -ENOMEM;
+
+	for (i = 0; i < n; i++) {
+		if (*pos + 8 > size)
+			return -EINVAL;
+		e = data + *pos;
+		regs[i].addr = get_unaligned_le16(e);
+		regs[i].value = get_unaligned_le16(e + 2);
+		regs[i].width = e[4];
+		regs[i].delay_us = get_unaligned_le16(e + 6);
+		*pos += 8;
+
+		if (regs[i].width == 0 && bursts) {
+			size_t len = regs[i].value;
+
+			if (!len || *pos + ALIGN(len, 4) > size)
+				return -EINVAL;
+			copy = devm_kmemdup(s5khm6->dev, data + *pos, len,
+					    GFP_KERNEL);
+			if (!copy)
+				return -ENOMEM;
+			regs[i].data = copy;
+			*pos += ALIGN(len, 4);
+		} else if (regs[i].width != 1 && regs[i].width != 2) {
+			return -EINVAL;
+		} else if (regs[i].width == 1 && regs[i].value > 0xff) {
+			return -EINVAL;
+		}
+	}
+
+	out->regs = regs;
+	out->num_regs = n;
+
+	return 0;
+}
+
+static int s5khm6_load_tables(struct s5khm6 *s5khm6)
+{
+	const char *fw_name = S5KHM6_FW_DEFAULT;
+	const struct firmware *fw;
+	struct s5khm6_table table;
+	unsigned int i, j, n;
+	char name[16];
+	bool bursts;
+	size_t pos;
+	int ret;
+
+	device_property_read_string(s5khm6->dev, "firmware-name", &fw_name);
+
+	ret = request_firmware(&fw, fw_name, s5khm6->dev);
+	if (ret)
+		return dev_err_probe(s5khm6->dev, ret,
+				     "failed to load register tables %s\n",
+				     fw_name);
+
+	ret = -EINVAL;
+	if (fw->size < 12)
+		goto out;
+	if (!memcmp(fw->data, "CAMREGS2", 8))
+		bursts = true;
+	else if (!memcmp(fw->data, "CAMREGS1", 8))
+		bursts = false;
+	else
+		goto out;
+
+	n = get_unaligned_le32(fw->data + 8);
+	pos = 12;
+	for (i = 0; i < n; i++) {
+		ret = s5khm6_parse_table(s5khm6, fw->data, fw->size, &pos,
+					 bursts, name, &table);
+		if (ret)
+			goto out;
+
+		if (!strcmp(name, "init"))
+			s5khm6->init_table = table;
+		for (j = 0; j < ARRAY_SIZE(s5khm6_supported_modes); j++)
+			if (!strcmp(name, s5khm6_supported_modes[j].table))
+				s5khm6->mode_tables[j] = table;
+	}
+
+	ret = 0;
+	if (!s5khm6->init_table.num_regs)
+		ret = -EINVAL;
+	for (j = 0; j < ARRAY_SIZE(s5khm6_supported_modes); j++)
+		if (!s5khm6->mode_tables[j].num_regs)
+			ret = -EINVAL;
+
+out:
+	release_firmware(fw);
+	if (ret)
+		dev_err(s5khm6->dev, "invalid register tables in %s\n", fw_name);
+
+	return ret;
+}
+
+static int s5khm6_identify_sensor(struct s5khm6 *s5khm6)
+{
+	u64 val;
+	int ret;
+
+	ret = cci_read(s5khm6->regmap, S5KHM6_REG_CHIP_ID, &val, NULL);
+	if (ret) {
+		dev_err(s5khm6->dev, "failed to read chip id: %d\n", ret);
+		return ret;
+	}
+
+	if (val != S5KHM6_CHIP_ID) {
+		dev_err(s5khm6->dev, "chip id mismatch: %x!=%llx\n",
+			S5KHM6_CHIP_ID, val);
+		return -ENODEV;
+	}
+
+	return 0;
+}
+
+static int s5khm6_check_hwcfg(struct s5khm6 *s5khm6)
+{
+	struct fwnode_handle *fwnode = dev_fwnode(s5khm6->dev), *ep;
+	struct v4l2_fwnode_endpoint bus_cfg = {
+		.bus_type = V4L2_MBUS_CSI2_CPHY,
+	};
+	int ret;
+
+	if (!fwnode)
+		return -ENODEV;
+
+	ep = fwnode_graph_get_next_endpoint(fwnode, NULL);
+	if (!ep)
+		return -EINVAL;
+
+	ret = v4l2_fwnode_endpoint_alloc_parse(ep, &bus_cfg);
+	fwnode_handle_put(ep);
+	if (ret)
+		return ret;
+
+	if (bus_cfg.bus.mipi_csi2.num_data_lanes != S5KHM6_DATA_LANES) {
+		dev_err(s5khm6->dev, "Invalid number of data lanes: %u\n",
+			bus_cfg.bus.mipi_csi2.num_data_lanes);
+		ret = -EINVAL;
+		goto endpoint_free;
+	}
+
+	ret = v4l2_link_freq_to_bitmap(s5khm6->dev, bus_cfg.link_frequencies,
+				       bus_cfg.nr_of_link_frequencies,
+				       s5khm6_link_freq_menu,
+				       ARRAY_SIZE(s5khm6_link_freq_menu),
+				       &s5khm6->link_freq_bitmap);
+
+endpoint_free:
+	v4l2_fwnode_endpoint_free(&bus_cfg);
+
+	return ret;
+}
+
+/* Power-up sequence of the module data: supplies, reset release, MCLK */
+static int s5khm6_power_on(struct device *dev)
+{
+	struct v4l2_subdev *sd = dev_get_drvdata(dev);
+	struct s5khm6 *s5khm6 = to_s5khm6(sd);
+	unsigned int i;
+	int ret;
+
+	for (i = 0; i < ARRAY_SIZE(s5khm6->supplies); i++) {
+		ret = regulator_enable(s5khm6->supplies[i].consumer);
+		if (ret)
+			goto disable_supplies;
+		usleep_range(USEC_PER_MSEC, 2 * USEC_PER_MSEC);
+	}
+
+	gpiod_set_value_cansleep(s5khm6->reset_gpio, 0);
+	usleep_range(5 * USEC_PER_MSEC, 6 * USEC_PER_MSEC);
+
+	ret = clk_prepare_enable(s5khm6->mclk);
+	if (ret)
+		goto assert_reset;
+	usleep_range(25 * USEC_PER_MSEC, 26 * USEC_PER_MSEC);
+
+	return 0;
+
+assert_reset:
+	gpiod_set_value_cansleep(s5khm6->reset_gpio, 1);
+disable_supplies:
+	while (i--)
+		regulator_disable(s5khm6->supplies[i].consumer);
+
+	return ret;
+}
+
+static int s5khm6_power_off(struct device *dev)
+{
+	struct v4l2_subdev *sd = dev_get_drvdata(dev);
+	struct s5khm6 *s5khm6 = to_s5khm6(sd);
+	unsigned int i;
+
+	clk_disable_unprepare(s5khm6->mclk);
+	gpiod_set_value_cansleep(s5khm6->reset_gpio, 1);
+	usleep_range(5 * USEC_PER_MSEC, 6 * USEC_PER_MSEC);
+
+	for (i = ARRAY_SIZE(s5khm6->supplies); i--; )
+		regulator_disable(s5khm6->supplies[i].consumer);
+
+	return 0;
+}
+
+static int s5khm6_probe(struct i2c_client *client)
+{
+	struct s5khm6 *s5khm6;
+	unsigned long freq;
+	unsigned int i;
+	int ret;
+
+	s5khm6 = devm_kzalloc(&client->dev, sizeof(*s5khm6), GFP_KERNEL);
+	if (!s5khm6)
+		return -ENOMEM;
+
+	s5khm6->dev = &client->dev;
+	v4l2_i2c_subdev_init(&s5khm6->sd, client, &s5khm6_subdev_ops);
+
+	s5khm6->regmap = devm_cci_regmap_init_i2c(client, 16);
+	if (IS_ERR(s5khm6->regmap))
+		return dev_err_probe(s5khm6->dev, PTR_ERR(s5khm6->regmap),
+				     "failed to init CCI\n");
+
+	s5khm6->mclk = devm_v4l2_sensor_clk_get(s5khm6->dev, NULL);
+	if (IS_ERR(s5khm6->mclk))
+		return dev_err_probe(s5khm6->dev, PTR_ERR(s5khm6->mclk),
+				     "failed to get MCLK clock\n");
+
+	freq = clk_get_rate(s5khm6->mclk);
+	if (freq != S5KHM6_MCLK_FREQ)
+		return dev_err_probe(s5khm6->dev, -EINVAL,
+				     "MCLK clock frequency %lu is not supported\n",
+				     freq);
+
+	ret = s5khm6_check_hwcfg(s5khm6);
+	if (ret)
+		return dev_err_probe(s5khm6->dev, ret,
+				     "failed to check HW configuration\n");
+
+	s5khm6->reset_gpio = devm_gpiod_get(s5khm6->dev, "reset",
+					    GPIOD_OUT_HIGH);
+	if (IS_ERR(s5khm6->reset_gpio))
+		return dev_err_probe(s5khm6->dev, PTR_ERR(s5khm6->reset_gpio),
+				     "cannot get reset GPIO\n");
+
+	for (i = 0; i < ARRAY_SIZE(s5khm6->supplies); i++)
+		s5khm6->supplies[i].supply = s5khm6_supply_names[i];
+	ret = devm_regulator_bulk_get(s5khm6->dev, ARRAY_SIZE(s5khm6->supplies),
+				      s5khm6->supplies);
+	if (ret)
+		return dev_err_probe(s5khm6->dev, ret,
+				     "failed to get supplies\n");
+
+	ret = s5khm6_load_tables(s5khm6);
+	if (ret)
+		return ret;
+
+	/* The sensor must be powered on to read the CHIP_ID register */
+	ret = s5khm6_power_on(s5khm6->dev);
+	if (ret)
+		return ret;
+
+	ret = s5khm6_identify_sensor(s5khm6);
+	if (ret) {
+		dev_err_probe(s5khm6->dev, ret, "failed to find sensor\n");
+		goto power_off;
+	}
+
+	s5khm6->mode = &s5khm6_supported_modes[0];
+	if (!(s5khm6->link_freq_bitmap & BIT(s5khm6->mode->link_freq_index))) {
+		ret = dev_err_probe(s5khm6->dev, -EINVAL,
+				    "default mode link frequency missing\n");
+		goto power_off;
+	}
+
+	ret = s5khm6_init_controls(s5khm6);
+	if (ret) {
+		dev_err_probe(s5khm6->dev, ret, "failed to init controls\n");
+		goto power_off;
+	}
+
+	s5khm6->sd.state_lock = s5khm6->ctrl_handler.lock;
+	s5khm6->sd.internal_ops = &s5khm6_internal_ops;
+	s5khm6->sd.flags |= V4L2_SUBDEV_FL_HAS_DEVNODE;
+	s5khm6->sd.entity.ops = &s5khm6_subdev_entity_ops;
+	s5khm6->sd.entity.function = MEDIA_ENT_F_CAM_SENSOR;
+	s5khm6->pad.flags = MEDIA_PAD_FL_SOURCE;
+
+	ret = media_entity_pads_init(&s5khm6->sd.entity, 1, &s5khm6->pad);
+	if (ret) {
+		dev_err_probe(s5khm6->dev, ret,
+			      "failed to init media entity pads\n");
+		goto v4l2_ctrl_handler_free;
+	}
+
+	ret = v4l2_subdev_init_finalize(&s5khm6->sd);
+	if (ret < 0) {
+		dev_err_probe(s5khm6->dev, ret,
+			      "failed to init media entity pads\n");
+		goto media_entity_cleanup;
+	}
+
+	pm_runtime_set_active(s5khm6->dev);
+	pm_runtime_enable(s5khm6->dev);
+
+	ret = v4l2_async_register_subdev_sensor(&s5khm6->sd);
+	if (ret < 0) {
+		dev_err_probe(s5khm6->dev, ret,
+			      "failed to register V4L2 subdev\n");
+		goto subdev_cleanup;
+	}
+
+	pm_runtime_set_autosuspend_delay(s5khm6->dev, 1000);
+	pm_runtime_use_autosuspend(s5khm6->dev);
+	pm_runtime_idle(s5khm6->dev);
+
+	return 0;
+
+subdev_cleanup:
+	v4l2_subdev_cleanup(&s5khm6->sd);
+	pm_runtime_disable(s5khm6->dev);
+	pm_runtime_set_suspended(s5khm6->dev);
+
+media_entity_cleanup:
+	media_entity_cleanup(&s5khm6->sd.entity);
+
+v4l2_ctrl_handler_free:
+	v4l2_ctrl_handler_free(s5khm6->sd.ctrl_handler);
+
+power_off:
+	s5khm6_power_off(s5khm6->dev);
+
+	return ret;
+}
+
+static void s5khm6_remove(struct i2c_client *client)
+{
+	struct v4l2_subdev *sd = i2c_get_clientdata(client);
+	struct s5khm6 *s5khm6 = to_s5khm6(sd);
+
+	v4l2_async_unregister_subdev(sd);
+	v4l2_subdev_cleanup(sd);
+	media_entity_cleanup(&sd->entity);
+	v4l2_ctrl_handler_free(sd->ctrl_handler);
+	pm_runtime_disable(s5khm6->dev);
+
+	if (!pm_runtime_status_suspended(s5khm6->dev)) {
+		s5khm6_power_off(s5khm6->dev);
+		pm_runtime_set_suspended(s5khm6->dev);
+	}
+}
+
+static const struct dev_pm_ops s5khm6_pm_ops = {
+	SET_RUNTIME_PM_OPS(s5khm6_power_off, s5khm6_power_on, NULL)
+};
+
+static const struct of_device_id s5khm6_of_match[] = {
+	{ .compatible = "samsung,s5khm6" },
+	{ /* sentinel */ }
+};
+MODULE_DEVICE_TABLE(of, s5khm6_of_match);
+
+static struct i2c_driver s5khm6_i2c_driver = {
+	.driver = {
+		.name = "s5khm6",
+		.pm = &s5khm6_pm_ops,
+		.of_match_table = s5khm6_of_match,
+	},
+	.probe = s5khm6_probe,
+	.remove = s5khm6_remove,
+};
+
+module_i2c_driver(s5khm6_i2c_driver);
+
+MODULE_DESCRIPTION("Samsung S5KHM6 image sensor driver");
+MODULE_LICENSE("GPL");
