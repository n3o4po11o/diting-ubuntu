From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: royka1 <397414+royka1@users.noreply.github.com>
Date: Sat, 22 Nov 2026 12:00:00 +0100
Subject: [PATCH] dt-bindings: media: i2c: Add Samsung S5KHM6 image sensor

108MP Samsung ISOCELL HM6 with a 3-trio MIPI C-PHY output, as used for
the rear main camera of the CN Xiaomi 12T Pro / Redmi K50 Ultra (the
EEA units carry the S5KHP1 instead).

---
 .../bindings/media/i2c/samsung,s5khm6.yaml   | 114 ++++++++++++++++++
 1 file changed, 114 insertions(+)
 create mode 100644 Documentation/devicetree/bindings/media/i2c/samsung,s5khm6.yaml

--- /dev/null
+++ b/Documentation/devicetree/bindings/media/i2c/samsung,s5khm6.yaml
@@ -0,0 +1,115 @@
+# SPDX-License-Identifier: (GPL-2.0-only OR BSD-2-Clause)
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/media/i2c/samsung,s5khm6.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: Samsung S5KHM6 Image Sensor
+
+description:
+  Samsung S5KHM6 (ISOCELL HM6) image sensor is a 108MP image sensor. The
+  sensor is controlled over a serial camera control bus protocol, the
+  widest supported output image frame size is 12000x9000, data output
+  format is RAW10 transferred over a 3-trio MIPI C-PHY interface. The
+  module specific register settings are loaded as firmware.
+
+maintainers:
+  - Roy Kaandorp <397414+royka1@users.noreply.github.com>
+
+allOf:
+  - $ref: /schemas/media/video-interface-devices.yaml#
+
+properties:
+  compatible:
+    const: samsung,s5khm6
+
+  reg:
+    maxItems: 1
+
+  clocks:
+    description: MCLK supply clock.
+    maxItems: 1
+
+  reset-gpios:
+    description: Active low GPIO connected to RESET pad of the sensor.
+    maxItems: 1
+
+  vdda-supply:
+    description: Analogue voltage supply, 2.9 volts.
+
+  vdda2-supply:
+    description: Second analogue voltage supply of the module.
+
+  vddd-supply:
+    description: Digital core voltage supply, 1.1 volts.
+
+  vddio-supply:
+    description: Digital I/O voltage supply, 1.8 volts.
+
+  firmware-name:
+    maxItems: 1
+    description: Register table firmware of the camera module.
+
+  port:
+    $ref: /schemas/graph.yaml#/$defs/port-base
+    additionalProperties: false
+
+    properties:
+      endpoint:
+        $ref: /schemas/media/video-interfaces.yaml#
+        unevaluatedProperties: false
+
+        properties:
+          bus-type:
+            const: 1
+
+          data-lanes:
+            items:
+              - const: 1
+              - const: 2
+              - const: 3
+
+        required:
+          - bus-type
+          - link-frequencies
+
+required:
+  - compatible
+  - reg
+  - port
+
+unevaluatedProperties: false
+
+examples:
+  - |
+      #include <dt-bindings/gpio/gpio.h>
+
+      i2c {
+          #address-cells = <1>;
+          #size-cells = <0>;
+
+          camera@10 {
+              compatible = "samsung,s5khm6";
+              reg = <0x10>;
+              clocks = <&camera_mclk 0>;
+              assigned-clocks = <&camera_mclk 0>;
+              assigned-clock-rates = <19200000>;
+              reset-gpios = <&gpio1 10 GPIO_ACTIVE_LOW>;
+              vdda-supply = <&vreg_2p9>;
+              vdda2-supply = <&vreg_3p1>;
+              vddd-supply = <&vreg_1p1>;
+              vddio-supply = <&vreg_1p8>;
+              firmware-name = "qcom/sm8475/xiaomi/diting/s5khm6-wide.camregs";
+
+              port {
+                  endpoint {
+                      bus-type = <1>;
+                      data-lanes = <1 2 3>;
+                      link-frequencies = /bits/ 64 <1195830000>;
+                      remote-endpoint = <&mipi_csi2_ep>;
+                  };
+              };
+          };
+      };
+
+...
