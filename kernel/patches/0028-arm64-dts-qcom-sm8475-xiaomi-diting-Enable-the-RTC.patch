From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: royka1 <397414+royka1@users.noreply.github.com>
Date: Mon, 12 Oct 2026 15:33:15 +0200
Subject: [PATCH 28/46] arm64: dts: qcom: sm8475-xiaomi-diting: Enable the RTC

Needed for wake alarms (suspend tests, alarms). Allow setting the time
as well: on Ubuntu nobody keeps Android's userspace time offset, so the
battery-backed PMIC RTC itself has to carry the time across reboots.
diting-rtc-sync writes it once NTP has synchronized (as on the Rubik Pi 3,
same PMK8350).
---
 arch/arm64/boot/dts/qcom/sm8475-xiaomi-diting.dts | 8 ++++++++
 1 file changed, 8 insertions(+)

diff --git a/arch/arm64/boot/dts/qcom/sm8475-xiaomi-diting.dts b/arch/arm64/boot/dts/qcom/sm8475-xiaomi-diting.dts
index 5fee1ea04..5c936cd0d 100644
--- a/arch/arm64/boot/dts/qcom/sm8475-xiaomi-diting.dts
+++ b/arch/arm64/boot/dts/qcom/sm8475-xiaomi-diting.dts
@@ -686,6 +686,14 @@ platform {
 	};
 };
 
+/* Wake alarms, and the battery-backed time across reboots: without
+ * Android's userspace offset the PMIC RTC has to be settable
+ * (diting-rtc-sync writes it once NTP has synchronized) */
+&pmk8350_rtc {
+	allow-set-time;
+	status = "okay";
+};
+
 &pcie0 {
 	max-link-speed = <2>;
 	status = "okay";
