# Xiaomi Diting (SM8475) fragment applied on top of arm64 defconfig.
# Each option is justified; see docs/KERNEL_PORTING.md.

CONFIG_LOCALVERSION="-diting"
# CONFIG_LOCALVERSION_AUTO is not set

# Root storage path built in, so the first boot does not depend on
# initramfs module loading: UFS host + QMP UFS PHY + inline crypto engine.
CONFIG_SCSI_UFS_QCOM=y
CONFIG_PHY_QCOM_QMP=y
CONFIG_PHY_QCOM_QMP_UFS=y
CONFIG_QCOM_INLINE_CRYPTO_ENGINE=y

# USB peripheral debug path: eUSB2 PHY, PTN3222 repeater on QUP I2C, gadget.
CONFIG_PHY_SNPS_EUSB2=y
CONFIG_PHY_NXP_PTN3222=y
CONFIG_I2C_QCOM_GENI=y
CONFIG_QCOM_GPI_DMA=y
CONFIG_USB_CONFIGFS=y
CONFIG_USB_CONFIGFS_NCM=y
CONFIG_USB_CONFIGFS_ACM=y
CONFIG_USB_CONFIGFS_MASS_STORAGE=y
CONFIG_USB_CONFIGFS_F_FS=y

# PMIC power-on block: power/volume-down keys in the initramfs and
# reboot-mode ("reboot bootloader" -> fastboot) via the PMK8350 SDAM cell.
CONFIG_POWER_RESET_QCOM_PON=y
CONFIG_NVMEM_SPMI_SDAM=y
CONFIG_NVMEM_REBOOT_MODE=y

# The PMK8350 RTC cannot be written from the AP on this device and holds no
# time (1970 plus uptime). Its driver is a module that udev loads at 5 s;
# with hctosys, that registration set the system clock back to 1970 after
# systemd had already restored /var/lib/systemd/timesync/clock at 4 s, and
# the clock stayed wrong until the first NTP reply. Wake alarms (patch 0028)
# do not need hctosys.
# CONFIG_RTC_HCTOSYS is not set

# Debug: console log in ramoops at the vendor location, readable from Android.
CONFIG_PSTORE=y
CONFIG_PSTORE_RAM=y
CONFIG_PSTORE_CONSOLE=y
CONFIG_PSTORE_PMSG=y

# Debug: /sys/power/pm_wakeup_irq and pm_debug_messages, to find what wakes
# the phone from suspend.
CONFIG_PM_DEBUG=y
CONFIG_PM_SLEEP_DEBUG=y

# Early display on the ABL splash buffer.
CONFIG_DRM=y
CONFIG_DRM_SIMPLEDRM=y
CONFIG_FRAMEBUFFER_CONSOLE=y

# ABL appends "bootconfig" to the command line and a bootconfig block to the
# ramdisk (vendor boot v4); parse it instead of leaving it as an unknown arg.
CONFIG_BOOT_CONFIG=y

# Ubuntu userspace expectations.
CONFIG_AUTOFS_FS=y
CONFIG_FANOTIFY=y
CONFIG_SECCOMP=y
CONFIG_CGROUP_BPF=y

# Touchscreen: ST FTM5 on SPI (local driver, patch 0007).
CONFIG_TOUCHSCREEN_ST_FTM5_SPI=m

# Display panel (local driver, patch 0009).
CONFIG_DRM_PANEL_XIAOMI_L12_36_02_0B=m

# GPU: Ubuntu's linux-firmware-qualcomm-graphics ships zstd-compressed
# firmware (a730_sqe.fw.zst, gmu_gen70000.bin.zst).
CONFIG_FW_LOADER_COMPRESS=y
CONFIG_FW_LOADER_COMPRESS_ZSTD=y

# Loudspeaker amplifiers (2x Cirrus CS35L41 on I2C).
CONFIG_SND_SOC_CS35L41_I2C=m

# Camera clock controller: without a driver the RPMh power domains never
# reach sync_state and stay at their maximum votes, which blocks the
# SoC-wide (CX) power collapse in suspend.
CONFIG_SM_CAMCC_8450=m

# Cameras: CAMSS raw capture over the CCI-controlled sensors; the rear
# ultrawide is a Samsung S5K4H7 (register tables loaded as firmware).
CONFIG_VIDEO_QCOM_CAMSS=m
CONFIG_I2C_QCOM_CCI=m
CONFIG_VIDEO_S5K4H7=m
CONFIG_VIDEO_S5KHP1=m
# Rear main (CN): Samsung S5KHM6, register tables loaded as firmware
CONFIG_VIDEO_S5KHM6=m
# Main camera lens actuators (AK7314 of the EEA module via ak7375;
# DW9800V of the CN module via dw9807-vcm)
CONFIG_VIDEO_AK7375=m
CONFIG_VIDEO_DW9807_VCM=m
# Camera LDOs (Willsemi WL2866D on i2c5)
CONFIG_REGULATOR_WL2866D=m
# Buffers for the libcamera software ISP: udmabuf (session user access via
# systemd's uaccess rule) and the system dma-buf heap
CONFIG_UDMABUF=y
CONFIG_DMABUF_HEAPS_SYSTEM=y

# Bring-up tracing: dynamic debug prints and ftrace/kprobe events, to follow
# the AudioReach/SoundWire paths on the phone (no runtime cost when unused).
CONFIG_DYNAMIC_DEBUG=y
CONFIG_FTRACE=y
CONFIG_FUNCTION_TRACER=y
CONFIG_FUNCTION_GRAPH_TRACER=y
CONFIG_KPROBES=y
CONFIG_KPROBE_EVENTS=y

# Snaps (owner request): squashfs with the compressors snaps use (xz mostly,
# also zstd/lzo/lz4) and xattrs; snapd's strict confinement needs AppArmor
# as an active LSM (order as Ubuntu's kernels).
CONFIG_SQUASHFS_XATTR=y
CONFIG_SQUASHFS_ZLIB=y
CONFIG_SQUASHFS_LZ4=y
CONFIG_SQUASHFS_LZO=y
CONFIG_SQUASHFS_XZ=y
CONFIG_SQUASHFS_ZSTD=y
CONFIG_SQUASHFS_FILE_DIRECT=y
CONFIG_SECURITY_NETWORK=y
CONFIG_SECURITY_APPARMOR=y
CONFIG_DEFAULT_SECURITY_APPARMOR=y
CONFIG_LSM="landlock,lockdown,yama,loadpin,safesetid,ipe,apparmor,bpf"

# Waydroid (owner request): binder through binderfs, PSI for Android's
# low-memory killer, uhid for input, and the container network (bridge,
# veth, NAT/masquerade through nftables as Ubuntu's iptables uses it, and
# the legacy iptables NAT table; CHECKSUM fills in the DHCP reply checksums
# of waydroid-net.sh, IPv6 masquerade serves its optional IPv6 NAT).
CONFIG_ANDROID_BINDER_IPC=y
CONFIG_ANDROID_BINDERFS=y
CONFIG_ANDROID_BINDER_DEVICES=""
CONFIG_PSI=y
CONFIG_UHID=m
CONFIG_NF_TABLES=m
CONFIG_NF_TABLES_INET=y
CONFIG_NF_TABLES_IPV4=y
CONFIG_NF_TABLES_IPV6=y
CONFIG_NFT_COMPAT=m
CONFIG_NFT_CT=m
CONFIG_NFT_NAT=m
CONFIG_NFT_MASQ=m
CONFIG_NFT_REJECT=m
CONFIG_NF_NAT=m
CONFIG_NETFILTER_XT_NAT=m
CONFIG_NETFILTER_XT_TARGET_MASQUERADE=m
CONFIG_NETFILTER_XT_TARGET_CHECKSUM=m
CONFIG_NETFILTER_XTABLES_LEGACY=y
CONFIG_IP_NF_IPTABLES_LEGACY=m
CONFIG_IP_NF_FILTER=m
CONFIG_IP_NF_NAT=m
CONFIG_IP_NF_TARGET_MASQUERADE=m
CONFIG_IP6_NF_IPTABLES_LEGACY=m
CONFIG_IP6_NF_FILTER=m
CONFIG_IP6_NF_NAT=m
CONFIG_IP6_NF_TARGET_MASQUERADE=m
# Android's netd (inside Waydroid) puts each network's routes in its own
# table selected by ip rules; without policy routing the container has no
# default route ("Network is unreachable"). The matches and targets below are
# the ones Android's base kernel config lists for netd's iptables chains,
# bandwidth accounting, firewall and socket handling.
CONFIG_IP_ADVANCED_ROUTER=y
CONFIG_IP_MULTIPLE_TABLES=y
CONFIG_IPV6_MULTIPLE_TABLES=y
CONFIG_INET_DIAG_DESTROY=y
CONFIG_INET_UDP_DIAG=y
CONFIG_NF_CONNTRACK_MARK=y
CONFIG_NETFILTER_NETLINK_LOG=m
CONFIG_NETFILTER_NETLINK_QUEUE=m
CONFIG_NETFILTER_XT_TARGET_CLASSIFY=m
CONFIG_NETFILTER_XT_TARGET_CONNMARK=m
CONFIG_NETFILTER_XT_TARGET_CT=m
CONFIG_NETFILTER_XT_TARGET_IDLETIMER=m
CONFIG_NETFILTER_XT_TARGET_MARK=m
CONFIG_NETFILTER_XT_TARGET_NFLOG=m
CONFIG_NETFILTER_XT_TARGET_NFQUEUE=m
CONFIG_NETFILTER_XT_TARGET_TCPMSS=m
CONFIG_NETFILTER_XT_TARGET_TPROXY=m
CONFIG_NETFILTER_XT_MATCH_BPF=m
CONFIG_NETFILTER_XT_MATCH_COMMENT=m
CONFIG_NETFILTER_XT_MATCH_CONNLIMIT=m
CONFIG_NETFILTER_XT_MATCH_CONNMARK=m
CONFIG_NETFILTER_XT_MATCH_HASHLIMIT=m
CONFIG_NETFILTER_XT_MATCH_HELPER=m
CONFIG_NETFILTER_XT_MATCH_IPRANGE=m
CONFIG_NETFILTER_XT_MATCH_LENGTH=m
CONFIG_NETFILTER_XT_MATCH_LIMIT=m
CONFIG_NETFILTER_XT_MATCH_MAC=m
CONFIG_NETFILTER_XT_MATCH_MARK=m
CONFIG_NETFILTER_XT_MATCH_OWNER=m
CONFIG_NETFILTER_XT_MATCH_PKTTYPE=m
CONFIG_NETFILTER_XT_MATCH_QUOTA=m
CONFIG_NETFILTER_XT_MATCH_SOCKET=m
CONFIG_NETFILTER_XT_MATCH_STATE=m
CONFIG_NETFILTER_XT_MATCH_STATISTIC=m
CONFIG_NETFILTER_XT_MATCH_STRING=m
CONFIG_NETFILTER_XT_MATCH_TIME=m
CONFIG_NETFILTER_XT_MATCH_U32=m
CONFIG_IP_NF_RAW=m
CONFIG_IP_NF_TARGET_REJECT=m
CONFIG_IP6_NF_RAW=m
CONFIG_IP6_NF_TARGET_REJECT=m
CONFIG_IP6_NF_MATCH_RPFILTER=m
CONFIG_NET_CLS_BPF=m
CONFIG_NET_ACT_BPF=m
CONFIG_QCOM_SMP2P_SLEEPSTATE=m

# Container/VM toolkit (compared against a kata-containers config): VPN
# (WireGuard), device mapper (disk encryption, verity for Android images,
# thin provisioning, snapshots, io throttling), F2FS for Android data
# images, and the extra container network interfaces.
CONFIG_WIREGUARD=y
CONFIG_DM_CRYPT=y
CONFIG_DM_VERITY=y
CONFIG_DM_THIN_PROVISIONING=y
CONFIG_DM_SNAPSHOT=y
CONFIG_BLK_DEV_THROTTLING=y
CONFIG_F2FS_FS=y
CONFIG_DUMMY=y
CONFIG_IPVLAN=y

# Docker/kata check follow-up: everything that still exists as a Kconfig
# symbol in 7.2 (=y where standalone, =m where the netfilter parents of
# this fragment are modular). The remaining "missing" items of the 5.10
# era lists are gone as symbols: merged into nf_tables/nf_conntrack/ipvs
# core (nft expressions, flowtable, families, ct protos, ipvs schedulers)
# or removed (legacy ip(6)tables match/target names, arptables, NAT
# helpers, DM_LOG_USERSPACE, DM_VERITY_FEC).
CONFIG_BLK_DEV_DM=y
CONFIG_BRIDGE_NF_EBTABLES=m
CONFIG_CFS_BANDWIDTH=y
CONFIG_CGROUP_NET_CLASSID=y
CONFIG_CRYPTO_SEQIV=y
CONFIG_DM_CACHE=y
CONFIG_DM_CACHE_SMQ=y
CONFIG_DM_CLONE=y
CONFIG_DM_DELAY=y
CONFIG_DM_DUST=y
CONFIG_DM_EBS=y
CONFIG_DM_ERA=y
CONFIG_DM_FLAKEY=y
CONFIG_DM_INIT=y
CONFIG_DM_INTEGRITY=y
CONFIG_DM_LOG_WRITES=y
CONFIG_DM_MULTIPATH=y
CONFIG_DM_RAID=y
CONFIG_DM_SWITCH=y
CONFIG_DM_UEVENT=y
CONFIG_DM_UNSTRIPED=y
CONFIG_DM_WRITECACHE=y
CONFIG_INET_ESP=y
CONFIG_IP6_NF_MATCH_AH=m
CONFIG_IP6_NF_MATCH_EUI64=m
CONFIG_IP6_NF_MATCH_FRAG=m
CONFIG_IP6_NF_MATCH_HL=m
CONFIG_IP6_NF_MATCH_IPV6HEADER=m
CONFIG_IP6_NF_MATCH_MH=m
CONFIG_IP6_NF_MATCH_OPTS=m
CONFIG_IP6_NF_MATCH_RT=m
CONFIG_IP6_NF_TARGET_SYNPROXY=m
CONFIG_IP_NF_MATCH_AH=m
CONFIG_IP_NF_MATCH_ECN=m
CONFIG_IP_NF_MATCH_TTL=m
CONFIG_IP_NF_TARGET_SYNPROXY=m
CONFIG_IP_SCTP=y
CONFIG_IP_VS_RR=m
CONFIG_MD=y
CONFIG_MD_LINEAR=y
CONFIG_MD_RAID0=y
CONFIG_MD_RAID10=y
CONFIG_MD_RAID1=y
CONFIG_MD_RAID456=y
CONFIG_NETFILTER_NETLINK_OSF=m
CONFIG_NETFILTER_SYNPROXY=m
CONFIG_NETFILTER_XT_MATCH_CGROUP=m
CONFIG_NETFILTER_XT_MATCH_ECN=m
CONFIG_NETFILTER_XT_MATCH_HL=m
CONFIG_NET_CLS_CGROUP=y
CONFIG_NF_CONNTRACK_BRIDGE=m
CONFIG_NF_CONNTRACK_FTP=m
CONFIG_NF_CONNTRACK_TFTP=m
CONFIG_NF_DUP_IPV4=m
CONFIG_NF_DUP_IPV6=m
CONFIG_NF_LOG_ARP=m
CONFIG_NF_LOG_IPV4=m
CONFIG_VXLAN=y
CONFIG_XFRM=y
CONFIG_XFRM_ALGO=y
CONFIG_XFRM_USER=y

# Every filesystem the kernel has, built in rather than as modules, so that
# a boot image alone carries them (owner's request, 2026-11-26). Left out on
# purpose: NTFS_FS, the old read-only NTFS driver (NTFS3 answers to the same
# "ntfs" mount type); EXT2_FS (deprecated; ext4 mounts ext2 through
# EXT4_USE_FOR_EXT2); the write support of ADFS and UFS (marked DANGEROUS);
# FSCACHE, CACHEFILES and the KUnit tests (not filesystems).
CONFIG_ADFS_FS=y
CONFIG_AFFS_FS=y
CONFIG_AFS_FS=y
CONFIG_BEFS_FS=y
CONFIG_BFS_FS=y
CONFIG_CEPH_FS=y
CONFIG_CEPH_FS_POSIX_ACL=y
CONFIG_CEPH_FS_SECURITY_LABEL=y
CONFIG_CIFS=y
CONFIG_CIFS_ALLOW_INSECURE_LEGACY=y
CONFIG_CIFS_XATTR=y
CONFIG_CIFS_POSIX=y
CONFIG_CIFS_UPCALL=y
CONFIG_CIFS_DFS_UPCALL=y
CONFIG_CIFS_SWN_UPCALL=y
CONFIG_CIFS_STATS2=y
CONFIG_CODA_FS=y
CONFIG_CRAMFS=y
CONFIG_ECRYPT_FS=y
CONFIG_ECRYPT_FS_MESSAGING=y
CONFIG_EFS_FS=y
CONFIG_EROFS_FS=y
CONFIG_EROFS_FS_XATTR=y
CONFIG_EROFS_FS_POSIX_ACL=y
CONFIG_EROFS_FS_SECURITY=y
CONFIG_EROFS_FS_ZIP=y
CONFIG_EROFS_FS_ZIP_LZMA=y
CONFIG_EROFS_FS_ZIP_DEFLATE=y
CONFIG_EROFS_FS_ZIP_ZSTD=y
CONFIG_EROFS_FS_BACKED_BY_FILE=y
CONFIG_EXFAT_FS=y
CONFIG_EXFAT_DEFAULT_IOCHARSET="utf8"
CONFIG_GFS2_FS=y
# DLM is the lock manager GFS2 and OCFS2 cluster with.
CONFIG_DLM=y
CONFIG_GFS2_FS_LOCKING_DLM=y
CONFIG_HFSPLUS_FS=y
CONFIG_HFS_FS=y
CONFIG_HPFS_FS=y
CONFIG_ISO9660_FS=y
CONFIG_JOLIET=y
CONFIG_ZISOFS=y
CONFIG_JFFS2_FS=y
CONFIG_JFS_FS=y
CONFIG_JFS_POSIX_ACL=y
CONFIG_JFS_SECURITY=y
CONFIG_JFS_STATISTICS=y
CONFIG_MINIX_FS=y
CONFIG_MSDOS_FS=y
# The 9P stack was modules (9pnet, 9pnet_fd, 9pnet_virtio, 9p); built in, so
# that its USB gadget transport can be built in as well.
CONFIG_NET_9P=y
CONFIG_NET_9P_FD=y
CONFIG_NET_9P_VIRTIO=y
CONFIG_9P_FS=y
CONFIG_9P_FS_POSIX_ACL=y
CONFIG_NET_9P_USBG=y
CONFIG_NFSD=y
CONFIG_NFSD_V2=y
CONFIG_NFSD_V2_ACL=y
CONFIG_NFSD_V3_ACL=y
CONFIG_NFSD_V4=y
CONFIG_NFSD_V4_SECURITY_LABEL=y
CONFIG_NFSD_PNFS=y
CONFIG_NFSD_BLOCKLAYOUT=y
CONFIG_NFSD_SCSILAYOUT=y
CONFIG_NFSD_FLEXFILELAYOUT=y
CONFIG_NFSD_V4_2_INTER_SSC=y
CONFIG_NFSD_V4_POSIX_ACLS=y
CONFIG_NFS_V2=y
CONFIG_NFS_V3_ACL=y
CONFIG_NFS_V4_1_MIGRATION=y
CONFIG_NILFS2_FS=y
CONFIG_NTFS3_FS=y
CONFIG_NTFS3_FS_POSIX_ACL=y
CONFIG_NTFS3_LZX_XPRESS=y
CONFIG_OCFS2_FS=y
CONFIG_OCFS2_FS_O2CB=y
CONFIG_OCFS2_FS_USERSPACE_CLUSTER=y
CONFIG_OCFS2_FS_STATS=y
CONFIG_OMFS_FS=y
CONFIG_ORANGEFS_FS=y
CONFIG_QFMT_V1=y
CONFIG_QFMT_V2=y
CONFIG_QNX4FS_FS=y
CONFIG_QNX6FS_FS=y
CONFIG_ROMFS_FS=y
CONFIG_SMB_SERVER=y
CONFIG_SMB_SERVER_CHECK_CAP_NET_ADMIN=y
CONFIG_SMB_SERVER_KERBEROS5=y
CONFIG_UDF_FS=y
CONFIG_UFS_FS=y
CONFIG_UNICODE=y
# FUSE was a module; built in, so that virtiofs can be built in too.
CONFIG_FUSE_FS=y
CONFIG_VIRTIO_FS=y
CONFIG_VXFS_FS=y
CONFIG_XFS_FS=y
CONFIG_XFS_QUOTA=y
CONFIG_XFS_POSIX_ACL=y
CONFIG_XFS_RT=y
CONFIG_XFS_ONLINE_SCRUB=y
CONFIG_XFS_ONLINE_SCRUB_STATS=y
CONFIG_XFS_ONLINE_REPAIR=y
CONFIG_XFS_SUPPORT_V4=y
CONFIG_XFS_SUPPORT_ASCII_CI=y
CONFIG_ZONEFS_FS=y
CONFIG_BLK_DEV_ZONED=y
# Features of the filesystems that are built in already: compression and
# encryption for f2fs, fscrypt and fs-verity for all of them, the mount-time
# choice of squashfs decompression mode, tmpfs quotas.
CONFIG_F2FS_FS_COMPRESSION=y
CONFIG_F2FS_FS_LZO=y
CONFIG_F2FS_FS_LZORLE=y
CONFIG_F2FS_FS_LZ4=y
CONFIG_F2FS_FS_LZ4HC=y
CONFIG_F2FS_FS_ZSTD=y
CONFIG_F2FS_FS_SECURITY=y
CONFIG_FS_ENCRYPTION=y
CONFIG_FS_ENCRYPTION_INLINE_CRYPT=y
CONFIG_FS_VERITY=y
CONFIG_FS_VERITY_BUILTIN_SIGNATURES=y
CONFIG_SQUASHFS_CHOICE_DECOMP_BY_MOUNT=y
CONFIG_TMPFS_QUOTA=y
CONFIG_QUOTA_NETLINK_INTERFACE=y
# Character sets for names on FAT, ISO 9660, SMB and NTFS volumes, and UTF-8
# as the default for FAT and exFAT (Chinese and other non-Latin names).
CONFIG_NLS_DEFAULT="utf8"
CONFIG_FAT_DEFAULT_IOCHARSET="utf8"
CONFIG_FAT_DEFAULT_UTF8=y
CONFIG_NLS_ASCII=y
CONFIG_NLS_CODEPAGE_1250=y
CONFIG_NLS_CODEPAGE_1251=y
CONFIG_NLS_CODEPAGE_737=y
CONFIG_NLS_CODEPAGE_775=y
CONFIG_NLS_CODEPAGE_850=y
CONFIG_NLS_CODEPAGE_852=y
CONFIG_NLS_CODEPAGE_855=y
CONFIG_NLS_CODEPAGE_857=y
CONFIG_NLS_CODEPAGE_860=y
CONFIG_NLS_CODEPAGE_861=y
CONFIG_NLS_CODEPAGE_862=y
CONFIG_NLS_CODEPAGE_863=y
CONFIG_NLS_CODEPAGE_864=y
CONFIG_NLS_CODEPAGE_865=y
CONFIG_NLS_CODEPAGE_866=y
CONFIG_NLS_CODEPAGE_869=y
CONFIG_NLS_CODEPAGE_874=y
CONFIG_NLS_CODEPAGE_932=y
CONFIG_NLS_CODEPAGE_936=y
CONFIG_NLS_CODEPAGE_949=y
CONFIG_NLS_CODEPAGE_950=y
CONFIG_NLS_ISO8859_13=y
CONFIG_NLS_ISO8859_14=y
CONFIG_NLS_ISO8859_15=y
CONFIG_NLS_ISO8859_2=y
CONFIG_NLS_ISO8859_3=y
CONFIG_NLS_ISO8859_4=y
CONFIG_NLS_ISO8859_5=y
CONFIG_NLS_ISO8859_6=y
CONFIG_NLS_ISO8859_7=y
CONFIG_NLS_ISO8859_8=y
CONFIG_NLS_ISO8859_9=y
CONFIG_NLS_KOI8_R=y
CONFIG_NLS_KOI8_U=y
CONFIG_NLS_MAC_CELTIC=y
CONFIG_NLS_MAC_CENTEURO=y
CONFIG_NLS_MAC_CROATIAN=y
CONFIG_NLS_MAC_CYRILLIC=y
CONFIG_NLS_MAC_GAELIC=y
CONFIG_NLS_MAC_GREEK=y
CONFIG_NLS_MAC_ICELAND=y
CONFIG_NLS_MAC_INUIT=y
CONFIG_NLS_MAC_ROMAN=y
CONFIG_NLS_MAC_ROMANIAN=y
CONFIG_NLS_MAC_TURKISH=y
CONFIG_NLS_UTF8=y
# Filesystems that were modules before this round, and the NVMe driver with
# them. Built in as well: what this block switched on above (fscrypt,
# fs-verity, zoned block devices) changes the layout of struct inode,
# struct super_block and struct gendisk, so a module compiled with the
# configuration before it does not fit this kernel - mounting btrfs from the
# package that was on the phone oopsed in open_ctree(). After this, no module
# of that package differs from this build in code, except the three that carry
# the patches 0106-0114 (they are in updates/ on the phone) and nvme-apple.ko,
# a driver for Apple SoCs that cannot be more than a module here and does
# nothing without its hardware.
CONFIG_BTRFS_FS=y
CONFIG_OVERLAY_FS=y
CONFIG_MTD_UBI=y
CONFIG_UBIFS_FS=y
CONFIG_CUSE=y
CONFIG_NVME_CORE=y
CONFIG_BLK_DEV_NVME=y
#
# binfmt_misc: interpreters and magic-based binary formats registered
# from /etc/binfmt.d (systemd-binfmt). BINFMT_ELF and BINFMT_SCRIPT were on.
CONFIG_BINFMT_MISC=y
