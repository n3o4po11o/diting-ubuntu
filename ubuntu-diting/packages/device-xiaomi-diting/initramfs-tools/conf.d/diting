# Xiaomi Diting: UFS, PHYs and USB are built into the kernel, so a small
# initramfs with only the listed modules is enough and keeps vendor_boot
# within its 96 MiB partition.
MODULES=list
COMPRESS=zstd
BUSYBOX=y
# The root fstab entry is a LABEL the build server cannot resolve, so the
# fsck hook would skip e2fsck and the initramfs would die at boot waiting
# for a root fsck it cannot run. Name the type explicitly.
FSTYPE=ext4
