#!/bin/sh
# Write the (NTP-synchronized) system clock into the battery-backed PMIC
# RTC, so reboots without network still come up with the right time.
# The DT enables allow-set-time (patch 0028); without it the driver
# rejects RTC_SET_TIME with ENODEV.
set -e
[ -c /dev/rtc0 ] || { echo "diting-rtc-sync: no /dev/rtc0"; exit 0; }
python3 - <<'EOF'
import fcntl, os, struct, time

tm = time.localtime()
buf = struct.pack('9i', tm.tm_sec, tm.tm_min, tm.tm_hour, tm.tm_mday,
                  tm.tm_mon, tm.tm_year - 1900, tm.tm_wday, tm.tm_yday, 0)
fd = os.open('/dev/rtc0', os.O_RDONLY)
fcntl.ioctl(fd, 0x4024700a, buf)  # RTC_SET_TIME
os.close(fd)
print('diting-rtc-sync: RTC set to', time.strftime('%F %T'))
EOF
