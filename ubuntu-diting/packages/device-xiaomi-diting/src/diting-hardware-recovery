#!/bin/sh
# Watch for hardware components stuck in a bad state after OTG role
# switches, long uptime, or suspend cycles, and recover them:
#
#   1. Bluetooth: the QCA6490 controller deadlocks on UART (tx timeout,
#      "Unable to drain transmitter") after OTG use or long uptime.
#      Fix: reload hci_uart module.
#
#   2. USB gadget: after an OTG adapter was used and removed the dwc3
#      controller can stick in a bad state ("failed to suspend: -11").
#      Fix: gadget down, unbind/rebind dwc3-qcom, gadget up again. It is
#      done only when a host has the gadget and usb0 still has no
#      carrier: with nothing on the cable, or with a charger, there is
#      none as a matter of course.
#
# Runs once a minute; each check is near-instant when healthy.
LOG_TAG=diting-hw-recovery
GADGET=/sys/kernel/config/usb_gadget/diting
BT_DOWN_COUNT=0
USB_DOWN_COUNT=0

check_bt() {
	# hci0 exists but DOWN = controller deadlock
	if [ -d /sys/class/bluetooth/hci0 ]; then
		if ! hciconfig hci0 2>/dev/null | grep -q "UP RUNNING"; then
			return 1
		fi
	fi
	return 0
}

recover_bt() {
	# Fast path: unbind/rebind the serial device from hci_uart_qca
	# (~100ms, re-downloads firmware). Fallback: module reload (~5s).
	logger -t "$LOG_TAG" "bluetooth controller down, recovering"
	local dev=serial0-0
	local drv=/sys/bus/serial/drivers/hci_uart_qca
	if [ -e "$drv/$dev" ]; then
		echo "$dev" > "$drv/unbind" 2>/dev/null
		sleep 1
		echo "$dev" > "$drv/bind" 2>/dev/null
		sleep 3
		hciconfig hci0 up 2>/dev/null || true
		logger -t "$LOG_TAG" "bluetooth recovered (fast rebind)"
		return
	fi
	# Slow fallback
	rmmod hci_uart btqca 2>/dev/null
	sleep 2
	modprobe hci_uart
	sleep 5
	hciconfig hci0 up 2>/dev/null || true
	logger -t "$LOG_TAG" "bluetooth recovered (module reload)"
}

check_usb() {
	# Stuck is: no carrier although a host has the gadget. Whether one has
	# is the controller's to say: its UDC is "not attached" until a host
	# resets the bus. With nothing on the cable, or with a charger (the
	# port is the UFP then as well), usb0 has no carrier as a matter of
	# course; taking that for stuck reset the controller every 126 s for
	# hours (2026-11-25).
	[ -d "$GADGET" ] || return 0
	ip link show usb0 2>/dev/null | grep -q "NO-CARRIER" || return 0
	udc="$(cat "$GADGET/UDC" 2>/dev/null)"
	case "$(cat "/sys/class/udc/$udc/state" 2>/dev/null)" in
	''|"not attached") return 0 ;;
	esac
	return 1
}

recover_usb() {
	logger -t "$LOG_TAG" "usb gadget stuck with a host attached, resetting dwc3"
	# Take the gadget down first. One left bound waits for its controller
	# and is bound again while the next one probes: that bind took the
	# controller into a NULL pointer dereference (kernel oops of
	# 2026-11-25).
	/usr/lib/diting/diting-usb-gadget stop
	local dev=a600000.usb
	local drv=/sys/bus/platform/drivers/dwc3-qcom
	echo "$dev" > "$drv/unbind" 2>/dev/null
	sleep 3
	echo "$dev" > "$drv/bind" 2>/dev/null
	sleep 3
	/usr/lib/diting/diting-usb-gadget start 2>/dev/null || true
	if [ -d "$GADGET" ] && [ -z "$(cat "$GADGET/UDC" 2>/dev/null)" ]; then
		logger -t "$LOG_TAG" "usb gadget is bound to no controller after the reset"
	fi
	logger -t "$LOG_TAG" "usb gadget recovery done"
}

while :; do
	sleep 60

	if ! check_bt; then
		BT_DOWN_COUNT=$((BT_DOWN_COUNT + 1))
		if [ "$BT_DOWN_COUNT" -ge 2 ]; then
			BT_DOWN_COUNT=0
			recover_bt
		fi
	else
		BT_DOWN_COUNT=0
	fi

	if ! check_usb; then
		USB_DOWN_COUNT=$((USB_DOWN_COUNT + 1))
		if [ "$USB_DOWN_COUNT" -ge 2 ]; then
			USB_DOWN_COUNT=0
			recover_usb
		fi
	else
		USB_DOWN_COUNT=0
	fi
done
