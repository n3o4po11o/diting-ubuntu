From a3fedd88c3e1b6934e9e833253c25d347f7026fb Mon Sep 17 00:00:00 2001
From: f <f@f>
Date: Fri, 27 Nov 2026 13:40:00 +0800
Subject: [PATCH 2/2] encoder: take a new bit rate and frame rate while the
 session runs

Upstream refuses a picture whose bit rate, peak or frame rate differs
from the first one: "changing encoder settings requires a new context"
(VA_STATUS_ERROR_UNIMPLEMENTED). Chromium does not make a new context
for that. It changes the bit rate every second or two while a call
runs, and does not even force a key frame for it: UpdateRates() keeps
the context and lets the next picture's buffers carry the new values
(docs/VIDEO_ENCODE.md, 2.6).

The kernel takes both rates at any time (the bitrate and peak controls
are dynamic, and S_PARM is accepted while streaming), so the driver now
drains the pipeline and sets them. The drain comes first because the
controls act on the whole session and not on one buffer: without it the
frames still queued would be encoded with the new rate. With the input
stamped a frame apart (the patch before this one), the new frame rate
reaches the firmware's rate control with the next stamp.

What still needs a new context: the level, the entropy mode, the
deblocking and the QP range. The kernel refuses the QP range control
once the stream is on, so it could not be changed even if it were taken.

tests/encoder/rate-change.cpp goes with this one.
---
 src/encoder.cpp               |  37 ++++-
 tests/encoder/meson.build     |   8 +
 tests/encoder/rate-change.cpp | 290 ++++++++++++++++++++++++++++++++++
 3 files changed, 333 insertions(+), 2 deletions(-)
 create mode 100644 tests/encoder/rate-change.cpp

diff --git a/src/encoder.cpp b/src/encoder.cpp
index f23ebc6..e213e79 100644
--- a/src/encoder.cpp
+++ b/src/encoder.cpp
@@ -414,6 +414,29 @@ struct Encoder::Impl {
         trace("encoder deblocking mode=%d alpha=%d beta=%d via V4L2", filter[0], filter[1],
               filter[2]);
     }
+    // A rate that changed while the session runs. The controls act on the whole
+    // session, not on one buffer, so this is called after a drain.
+    void set_rates(const EncodeSettings &s) {
+        if (settings.rate_control != VA_RC_CQP) {
+            control(V4L2_CID_MPEG_VIDEO_BITRATE, s.bitrate);
+            control(V4L2_CID_MPEG_VIDEO_BITRATE_PEAK, s.peak_bitrate);
+        }
+        // The kernel takes the frame rate down (and checks the level against
+        // it) but does not pass it to the firmware mid-session: the rate the
+        // session started with stays in the stream's timing information. The
+        // stamps below carry the new rate to the rate control regardless.
+        for (unsigned type : {CAPTURE, OUTPUT}) {
+            v4l2_streamparm parm{};
+            parm.type = type;
+            parm.parm.output.timeperframe.numerator = s.fps_den;
+            parm.parm.output.timeperframe.denominator = s.fps_num;
+            checked(fd, VIDIOC_S_PARM, &parm, "encoder S_PARM");
+        }
+        settings.bitrate = s.bitrate;
+        settings.peak_bitrate = s.peak_bitrate;
+        settings.fps_num = s.fps_num;
+        settings.fps_den = s.fps_den;
+    }
     void queue_capture(unsigned index) {
         QueueBuffer q(CAPTURE, index);
         q.plane.length = capture[index]->size;
@@ -744,10 +767,16 @@ std::shared_ptr<EncodeTask> Encoder::encode(const EncodeSettings &s, const Encod
                      s.hevc_sequence.general_tier_flag == e.settings.hevc_sequence.general_tier_flag
                : s.sequence.level_idc == e.settings.sequence.level_idc &&
                      p.params.pic_fields.bits.entropy_coding_mode_flag == e.entropy) &&
-              s.fps_num == e.settings.fps_num && s.fps_den == e.settings.fps_den &&
-              s.bitrate == e.settings.bitrate && s.peak_bitrate == e.settings.peak_bitrate &&
               s.min_qp == e.settings.min_qp && s.max_qp == e.settings.max_qp,
           "changing encoder settings requires a new context", VA_STATUS_ERROR_UNIMPLEMENTED);
+    // The bit rate, the peak and the frame rate may change while the session
+    // runs. A browser changes the bit rate every second or two: it renders the
+    // rate control buffer again and sends the next picture, with no new
+    // context and no key frame. The QP range may not: the kernel refuses
+    // that control once the stream is on.
+    const bool rates_changed = s.bitrate != e.settings.bitrate ||
+                               s.peak_bitrate != e.settings.peak_bitrate ||
+                               s.fps_num != e.settings.fps_num || s.fps_den != e.settings.fps_den;
     const bool idr =
         s.hevc ? p.hevc_params.pic_fields.bits.idr_pic_flag : p.params.pic_fields.bits.idr_pic_flag;
     const bool intra =
@@ -792,6 +821,10 @@ std::shared_ptr<EncodeTask> Encoder::encode(const EncodeSettings &s, const Encod
     try {
         // Scalar V4L2 controls have no per-request association. Drain before a
         // QP change or forced IDR so they cannot affect an earlier queued frame.
+        if (rates_changed) {
+            e.finish();
+            e.set_rates(s);
+        }
         if ((s.rate_control == VA_RC_CQP && qp != e.current_qp) || (intra && e.token))
             e.finish();
         if (e.jobs.size() == e.input_count + e.capture.size()) {
