+void validate_i420(const Memory &m, unsigned width, unsigned height) {
+    const uint64_t chroma_rows = (height + 1) / 2;
+    check(m.stride % 2 == 0 && m.storage_height % 2 == 0 && (width + 1) / 2 <= m.stride / 2 &&
+              height <= m.storage_height && chroma_rows <= m.storage_height / 2 &&
+              m.chroma_v() + (chroma_rows - 1) * (m.stride / 2) + (width + 1) / 2 <= m.size,
+          "I420 surface copy exceeds buffer layout", VA_STATUS_ERROR_INVALID_SURFACE);
