index 0000000..7ac84b1
--- /dev/null
+++ b/tests/encoder/i420-surface.cpp
@@ -0,0 +1,378 @@
+// SPDX-License-Identifier: MIT
+// Board test: c++ -std=c++17 -O2 tests/encoder/i420-surface.cpp -lva -lva-drm -o i420-surface
+// Usage: i420-surface [--hevc]
+// Surfaces in I420, which is what FFmpeg's hwupload asks for when it uploads
+// frames from memory (and with it RustDesk and every client built on
+// libavutil), on the encoder session of async.cpp: 640x480, CQP, QP 24 or 28
+// in blocks of 23 frames, an IDR every 17 frames.
+//
+//  1. vaQuerySurfaceAttributes offers I420 for the encoder's config.
+//  2. The image paths on an I420 surface, against a frame held in three
+//     planes. Written through vaDeriveImage, read back with vaGetImage as
+//     I420 and as NV12; written with vaPutImage from an I420 image and from
+//     an NV12 image, read back again. Every sample must be where it started,
+//     U and V not swapped. Export is refused.
+//  3. The encoder. The same 96 frames go in twice: A the way that has always
+//     worked, an I420 image put onto an NV12 surface with vaPutImage; B the
+//     way libavutil does it, written straight into an I420 surface through
+//     vaDeriveImage. The two bitstreams must be the same: the hardware gets
+//     the same samples, or the streams differ.
+//
+// Exits 0 when all of that holds, 1 when the streams differ, 2 otherwise.
+#include <va/va.h>
+#include <va/va_drm.h>
+#include <va/va_enc_h264.h>
+#include <va/va_enc_hevc.h>
+#include <fcntl.h>
+#include <unistd.h>
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+#include <string>
+#include <vector>
+
+namespace {
+bool hevc = false;
+constexpr unsigned count = 12, width = 640, height = 480, frames = 96;
+
+void expect(VAStatus got, VAStatus wanted = VA_STATUS_SUCCESS) {
+    if (got != wanted) {
+        std::fprintf(stderr, "Expected %s, got %s\n", vaErrorStr(wanted), vaErrorStr(got));
+        std::exit(2);
+    }
+}
+void require(bool value, const char *message) {
+    if (!value) {
+        std::fprintf(stderr, "%s\n", message);
+        std::exit(2);
+    }
+}
+
+// The frame in three planes: the luma of async.cpp, and chroma in which U and
+// V differ at every sample, so that a swap shows.
+unsigned char sample(unsigned plane, unsigned x, unsigned y, unsigned frame) {
+    if (!plane)
+        return 16 + (x / 8 + y / 8 + frame * 7) % 200;
+    return plane == 1 ? (x + y * 3 + frame * 5) % 256
+                      : (x * 3 + y + frame * 11 + 97) % 256;
+}
+
+VAImage image(VADisplay d, unsigned fourcc) {
+    VAImageFormat format{};
+    format.fourcc = fourcc;
+    format.byte_order = VA_LSB_FIRST;
+    format.bits_per_pixel = 12;
+    VAImage out;
+    expect(vaCreateImage(d, &format, width, height, &out));
+    return out;
+}
+
+// A mapped image, I420 or NV12, filled with a frame or held against one.
+struct Mapped {
+    VADisplay display;
+    VAImage info;
+    unsigned char *data;
+    Mapped(VADisplay d, const VAImage &i) : display(d), info(i) {
+        expect(vaMapBuffer(d, i.buf, reinterpret_cast<void **>(&data)));
+    }
+    ~Mapped() { vaUnmapBuffer(display, info.buf); }
+    bool i420() const { return info.format.fourcc == VA_FOURCC_I420; }
+    // The chroma sample: in a plane of its own in I420, interleaved in NV12.
+    unsigned char *chroma(unsigned x, unsigned y, unsigned plane) {
+        if (i420())
+            return data + info.offsets[plane] + y * info.pitches[plane] + x;
+        return data + info.offsets[1] + y * info.pitches[1] + 2 * x + (plane - 1);
+    }
+    void fill(unsigned frame) {
+        for (unsigned y = 0; y < height; ++y)
+            for (unsigned x = 0; x < width; ++x)
+                data[info.offsets[0] + y * info.pitches[0] + x] = sample(0, x, y, frame);
+        for (unsigned y = 0; y < height / 2; ++y)
+            for (unsigned x = 0; x < width / 2; ++x)
+                for (unsigned plane = 1; plane < 3; ++plane)
+                    *chroma(x, y, plane) = sample(plane, x, y, frame);
+    }
+    bool equals(unsigned frame) {
+        for (unsigned y = 0; y < height; ++y)
+            for (unsigned x = 0; x < width; ++x)
+                if (data[info.offsets[0] + y * info.pitches[0] + x] != sample(0, x, y, frame))
+                    return false;
+        for (unsigned y = 0; y < height / 2; ++y)
+            for (unsigned x = 0; x < width / 2; ++x)
+                for (unsigned plane = 1; plane < 3; ++plane)
+                    if (*chroma(x, y, plane) != sample(plane, x, y, frame))
+                        return false;
+        return true;
+    }
+};
+
+// The way libavutil uploads: the surface's own image, written in place.
+void derive(VADisplay d, VASurfaceID surface, unsigned frame) {
+    VAImage own;
+    expect(vaDeriveImage(d, surface, &own));
+    require(own.format.fourcc == VA_FOURCC_I420 && own.num_planes == 3,
+            "the image derived from an I420 surface is not I420 in three planes");
+    {
+        Mapped mapped(d, own);
+        mapped.fill(frame);
+    }
+    vaDestroyImage(d, own.image_id);
+}
+// The frame put on a surface from an image of the given format.
+void put(VADisplay d, VASurfaceID surface, unsigned fourcc, unsigned frame) {
+    VAImage write = image(d, fourcc);
+    {
+        Mapped mapped(d, write);
+        mapped.fill(frame);
+    }
+    expect(vaPutImage(d, surface, write.image_id, 0, 0, width, height, 0, 0, width, height));
+    vaDestroyImage(d, write.image_id);
+}
+// Whether a surface, read back as an image of the given format, is the frame.
+bool holds(VADisplay d, VASurfaceID surface, unsigned fourcc, unsigned frame) {
+    VAImage read = image(d, fourcc);
+    expect(vaGetImage(d, surface, 0, 0, width, height, read.image_id));
+    bool same;
+    {
+        Mapped mapped(d, read);
+        same = mapped.equals(frame);
+    }
+    vaDestroyImage(d, read.image_id);
+    return same;
+}
+
+void create_inputs(VADisplay d, bool planar, VASurfaceID *surfaces) {
+    if (!planar) {
+        expect(vaCreateSurfaces(d, VA_RT_FORMAT_YUV420, width, height, surfaces, count, nullptr, 0));
+        return;
+    }
+    VASurfaceAttrib attrs[2]{};
+    attrs[0].type = VASurfaceAttribPixelFormat;
+    attrs[0].flags = VA_SURFACE_ATTRIB_SETTABLE;
+    attrs[0].value.type = VAGenericValueTypeInteger;
+    attrs[0].value.value.i = VA_FOURCC_I420;
+    attrs[1] = attrs[0];
+    attrs[1].type = VASurfaceAttribMemoryType;
+    attrs[1].value.value.i = VA_SURFACE_ATTRIB_MEM_TYPE_VA;
+    expect(vaCreateSurfaces(d, VA_RT_FORMAT_YUV420, width, height, surfaces, count, attrs, 2));
+}
+
+struct Session {
+    VADisplay display;
+    VAConfigID config;
+    VAContextID context;
+    bool planar;
+    VASurfaceID inputs[count], recon[count];
+    VABufferID coded[count];
+    explicit Session(VADisplay d, bool p) : display(d), planar(p) {
+        VAConfigAttrib attr{VAConfigAttribRateControl, VA_RC_CQP};
+        expect(vaCreateConfig(d, hevc ? VAProfileHEVCMain : VAProfileH264High, VAEntrypointEncSlice,
+                              &attr, 1, &config));
+        create_inputs(d, planar, inputs);
+        expect(vaCreateSurfaces(d, VA_RT_FORMAT_YUV420, width, height, recon, count, nullptr, 0));
+        expect(vaCreateContext(d, config, width, height, VA_PROGRESSIVE, inputs, count, &context));
+        for (unsigned i = 0; i < count; ++i)
+            expect(vaCreateBuffer(d, context, VAEncCodedBufferType, width * height * 3, 1, nullptr,
+                                  &coded[i]));
+    }
+    ~Session() {
+        if (context != VA_INVALID_ID)
+            vaDestroyContext(display, context);
+        for (auto id : coded)
+            if (id != VA_INVALID_ID)
+                vaDestroyBuffer(display, id);
+        for (auto id : inputs)
+            if (id != VA_INVALID_SURFACE)
+                vaDestroySurfaces(display, &id, 1);
+        vaDestroySurfaces(display, recon, count);
+        vaDestroyConfig(display, config);
+    }
+    // The frame goes in, then is encoded; an IDR every 17 frames.
+    void submit(unsigned frame) {
+        unsigned i = frame % count;
+        if (planar)
+            derive(display, inputs[i], frame);
+        else
+            put(display, inputs[i], VA_FOURCC_I420, frame);
+        VAEncPictureParameterBufferH264 pic{};
+        VAEncSliceParameterBufferH264 slice{};
+        VAEncPictureParameterBufferHEVC hp{};
+        VAEncSliceParameterBufferHEVC sl{};
+        const bool idr = frame % 17 == 0;
+        VABufferID parameters[3];
+        if (hevc) {
+            VAEncSequenceParameterBufferHEVC hs{};
+            hs.general_profile_idc = 1;
+            hs.general_level_idc = 93;
+            hs.pic_width_in_luma_samples = width;
+            hs.pic_height_in_luma_samples = height;
+            hs.seq_fields.bits.chroma_format_idc = 1;
+            hs.log2_diff_max_min_luma_coding_block_size = 2;
+            hs.ip_period = 1;
+            hp.decoded_curr_pic.picture_id = recon[i];
+            hp.coded_buf = coded[i];
+            hp.pic_init_qp = (frame / 23) % 2 ? 28 : 24;
+            hp.pic_fields.bits.idr_pic_flag = idr;
+            hp.pic_fields.bits.coding_type = idr ? 1 : 2;
+            hp.pic_fields.bits.reference_pic_flag = 1;
+            sl.num_ctu_in_slice = (width + 31) / 32 * ((height + 31) / 32);
+            sl.slice_type = idr ? 2 : 1;
+            sl.ref_pic_list0[0].picture_id = recon[(i + count - 1) % count];
+            sl.slice_fields.bits.last_slice_of_pic_flag = 1;
+            sl.slice_fields.bits.slice_loop_filter_across_slices_enabled_flag = 1;
+            expect(vaCreateBuffer(display, context, VAEncSequenceParameterBufferType, sizeof(hs), 1,
+                                  &hs, &parameters[0]));
+            expect(vaCreateBuffer(display, context, VAEncPictureParameterBufferType, sizeof(hp), 1,
+                                  &hp, &parameters[1]));
+            expect(vaCreateBuffer(display, context, VAEncSliceParameterBufferType, sizeof(sl), 1, &sl,
+                                  &parameters[2]));
+        } else {
+            VAEncSequenceParameterBufferH264 seq{};
+            seq.level_idc = 31;
+            seq.picture_width_in_mbs = width / 16;
+            seq.picture_height_in_mbs = height / 16;
+            seq.seq_fields.bits.frame_mbs_only_flag = 1;
+            seq.seq_fields.bits.chroma_format_idc = 1;
+            seq.ip_period = 1;
+            seq.intra_period = seq.intra_idr_period = 17;
+            seq.max_num_ref_frames = 1;
+            pic.CurrPic.picture_id = recon[i];
+            pic.coded_buf = coded[i];
+            pic.pic_init_qp = (frame / 23) % 2 ? 28 : 24;
+            pic.pic_fields.bits.idr_pic_flag = idr;
+            pic.pic_fields.bits.reference_pic_flag = 1;
+            pic.pic_fields.bits.entropy_coding_mode_flag = 1;
+            slice.num_macroblocks = width / 16 * (height / 16);
+            slice.slice_type = idr ? 2 : 0;
+            slice.macroblock_info = VA_INVALID_ID;
+            slice.RefPicList0[0].picture_id = recon[(i + count - 1) % count];
+            expect(vaCreateBuffer(display, context, VAEncSequenceParameterBufferType, sizeof(seq),
+                                  1, &seq, &parameters[0]));
+            expect(vaCreateBuffer(display, context, VAEncPictureParameterBufferType, sizeof(pic), 1,
+                                  &pic, &parameters[1]));
+            expect(vaCreateBuffer(display, context, VAEncSliceParameterBufferType, sizeof(slice), 1,
+                                  &slice, &parameters[2]));
+        }
+        expect(vaBeginPicture(display, context, inputs[i]));
+        expect(vaRenderPicture(display, context, parameters, 3));
+        expect(vaEndPicture(display, context));
+        for (auto id : parameters)
+            expect(vaDestroyBuffer(display, id));
+    }
+    void collect(unsigned frame, std::vector<unsigned char> &stream, std::vector<size_t> &sizes) {
+        unsigned i = frame % count;
+        expect(vaSyncBuffer(display, coded[i], VA_TIMEOUT_INFINITE));
+        void *data;
+        expect(vaMapBuffer(display, coded[i], &data));
+        auto *seg = static_cast<VACodedBufferSegment *>(data);
+        require(seg->size && seg->buf && !seg->next && !seg->status, "invalid coded segment");
+        auto *bytes = static_cast<unsigned char *>(seg->buf);
+        stream.insert(stream.end(), bytes, bytes + seg->size);
+        sizes.push_back(seg->size);
+        expect(vaUnmapBuffer(display, coded[i]));
+    }
+};
+
+void encode(VADisplay d, bool planar, std::vector<unsigned char> &stream,
+            std::vector<size_t> &sizes) {
+    Session session(d, planar);
+    stream.clear();
+    sizes.clear();
+    for (unsigned i = 0; i < frames; ++i) {
+        session.submit(i);
+        session.collect(i, stream, sizes);
+    }
+}
+
+void write(const char *path, const std::vector<unsigned char> &stream) {
+    FILE *f = std::fopen(path, "wb");
+    require(f && std::fwrite(stream.data(), 1, stream.size(), f) == stream.size(), "write");
+    std::fclose(f);
+}
+} // namespace
+
+int main(int argc, char **argv) {
+    for (int i = 1; i < argc; ++i)
+        if (!std::strcmp(argv[i], "--hevc"))
+            hevc = true;
+    int fd = open("/dev/dri/renderD128", O_RDWR | O_CLOEXEC);
+    require(fd >= 0, "open the render node");
+    VADisplay display = vaGetDisplayDRM(fd);
+    int major, minor;
+    expect(vaInitialize(display, &major, &minor));
+    const VAProfile profile = hevc ? VAProfileHEVCMain : VAProfileH264High;
+
+    // 1. The config offers I420.
+    VAConfigAttrib attr{VAConfigAttribRateControl, VA_RC_CQP};
+    VAConfigID config;
+    expect(vaCreateConfig(display, profile, VAEntrypointEncSlice, &attr, 1, &config));
+    unsigned n = 0;
+    expect(vaQuerySurfaceAttributes(display, config, nullptr, &n));
+    std::vector<VASurfaceAttrib> attrs(n);
+    expect(vaQuerySurfaceAttributes(display, config, attrs.data(), &n));
+    unsigned formats = 0;
+    bool offered = false;
+    for (unsigned i = 0; i < n; ++i) {
+        if (attrs[i].type != VASurfaceAttribPixelFormat)
+            continue;
+        ++formats;
+        offered |= attrs[i].value.value.i == VA_FOURCC_I420;
+    }
+    require(formats > 1 && offered, "I420 is not offered for the encoder's config");
+    vaDestroyConfig(display, config);
+    std::printf("1. I420 is offered for the encoder's config, with %u pixel formats in all\n",
+                formats);
+
+    // 2. The image paths.
+    VASurfaceID surface[count];
+    create_inputs(display, true, surface);
+    derive(display, surface[0], 100);
+    require(holds(display, surface[0], VA_FOURCC_I420, 100),
+            "written through the derived image, read back as I420: not the frame");
+    require(holds(display, surface[0], VA_FOURCC_NV12, 100),
+            "written through the derived image, read back as NV12: not the frame");
+    put(display, surface[0], VA_FOURCC_I420, 101);
+    require(holds(display, surface[0], VA_FOURCC_I420, 101),
+            "put from an I420 image, read back: not the frame");
+    put(display, surface[0], VA_FOURCC_NV12, 102);
+    require(holds(display, surface[0], VA_FOURCC_I420, 102),
+            "put from an NV12 image, read back as I420: not the frame");
+    require(holds(display, surface[0], VA_FOURCC_NV12, 102),
+            "put from an NV12 image, read back as NV12: not the frame");
+#if VA_CHECK_VERSION(2, 4, 0)
+    VADRMPRIMESurfaceDescriptor descriptor{};
+    require(vaExportSurfaceToDMABuf(display, surface[0], VA_SURFACE_ATTRIB_MEM_TYPE_DRM_PRIME_2,
+                                    VA_EXPORT_SURFACE_READ_ONLY, &descriptor) ==
+                VA_STATUS_ERROR_UNIMPLEMENTED,
+            "an I420 surface could be exported");
+#endif
+    vaDestroySurfaces(display, surface, count);
+    std::puts("2. the image paths on an I420 surface: every sample where it was put");
+
+    // 3. The encoder, by the two ways in.
+    std::vector<unsigned char> a, b;
+    std::vector<size_t> a_sizes, b_sizes;
+    encode(display, false, a, a_sizes);
+    encode(display, true, b, b_sizes);
+    if (a == b) {
+        std::printf("3. the same %u frames by vaPutImage onto NV12 and written straight into I420: "
+                    "one bitstream, %zu bytes\n",
+                    frames, a.size());
+        return 0;
+    }
+    unsigned differing = 0, first = frames;
+    for (unsigned i = 0; i < frames; ++i)
+        if (a_sizes[i] != b_sizes[i]) {
+            ++differing;
+            if (first == frames)
+                first = i;
+        }
+    std::printf("3. the two ways in give different bitstreams: %zu and %zu bytes; frames whose size "
+                "differs: %u, the first is frame %u%s\n",
+                a.size(), b.size(), differing, first,
+                differing ? "" : " (none: same sizes, other bytes)");
+    write("i420-a.h264", a);
+    write("i420-b.h264", b);
+    std::puts("   both are written: i420-a.h264 (put onto NV12) and i420-b.h264 (written into I420)");
+    return 1;
+}
